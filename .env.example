# Configuration du serveur
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Configuration de la base de données PostgreSQL
DB_NAME=blog
DB_USER=votre_utilisateur
DB_PASSWORD=votre_mot_de_passe
DB_HOST=localhost
DB_PORT=5432
DB_DIALECT=postgres

# Secret pour les sessions (IMPORTANT: Générer un secret fort aléatoire en production)
# Vous pouvez utiliser: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CHANGEZ_CE_SECRET_PAR_UN_VRAI_SECRET_ALEATOIRE

# Configuration email pour la réinitialisation de mot de passe
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=votre_email@gmail.com
EMAIL_PASSWORD=votre_mot_de_passe_application
EMAIL_FROM=noreply@miamor.com

# Configuration CSRF (optionnel, généré automatiquement si non fourni)
CSRF_SECRET=un_autre_secret_pour_csrf_protection