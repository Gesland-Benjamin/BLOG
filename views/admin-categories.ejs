<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="container" style="margin-top:60px;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Gestion des catégories</h1>
        <a href="/admin/categories/new" class="btn btn-bd-primary btn-sm">Ajouter une catégorie</a>
      </div>

      <% if (message) { %>
        <div class="alert alert-<%= message.type === 'success' ? 'success' : 'danger' %> alert-dismissible fade show" role="alert">
          <%= message.text %>
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% } %>

      <div class="card border-0 shadow-sm">
        <% if (categories.length === 0) { %>
          <div class="card-body text-center py-5 text-muted">
            <p>Aucune catégorie n'existe encore.</p>
            <a href="/admin/categories/new" class="btn btn-sm btn-bd-primary">Créer une catégorie</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Nom</th>
                  <th class="text-center">Articles</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% categories.forEach(category => { %>
                  <tr>
                    <td class="fw-semibold"><%= category.nom %></td>
                    <td class="text-center">
                      <span class="badge text-bg-secondary"><%= category.articleCount %></span>
                    </td>
                    <td class="text-end">
                      <a href="/admin/categories/<%= category.id %>/edit" class="btn btn-sm btn-outline-secondary">Éditer</a>
                      <% if (category.articleCount === 0) { %>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory('<%= category.id %>', '<%= category.nom %>')">Supprimer</button>
                      <% } else { %>
                        <button class="btn btn-sm btn-outline-danger" disabled title="Cette catégorie est utilisée par <%= category.articleCount %> article(s)">Supprimer</button>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <%- include('partials/pagination', { pagination, baseUrl }) %>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      function deleteCategory(categoryId, categoryName) {
        if (confirm(`Êtes-vous sûr de vouloir supprimer la catégorie "${categoryName}" ?`)) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/categories/${categoryId}?_method=DELETE`;
          document.body.appendChild(form);
          form.submit();
        }
      }
    </script>
  </body>
</html>
