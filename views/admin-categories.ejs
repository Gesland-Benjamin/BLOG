<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>Gestion des catégories</h1>
          <a href="/admin/categories/new" class="admin-btn primary">Ajouter une catégorie</a>
        </div>

        <% if (message) { %>
          <div class="admin-alert <%= message.type === 'success' ? 'success' : 'error' %>" role="alert">
            <%= message.text %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <div class="admin-table-card">
          <% if (categories.length === 0) { %>
            <div class="admin-empty-state">
              <p>Aucune catégorie n'existe encore.</p>
              <a href="/admin/categories/new" class="admin-btn primary">Créer une catégorie</a>
            </div>
          <% } else { %>
            <div class="admin-table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Nom</th>
                    <th class="text-center">Articles</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% categories.forEach(category => { %>
                    <tr>
                      <td class="admin-table-name">
                        <span style="color:#1a0c00 !important; font-weight:700; display:inline-block;">
                          <%= category.name || category.nom %>
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="admin-badge secondary"><%= category.articleCount %></span>
                      </td>
                      <td class="text-end">
                        <a href="/admin/categories/<%= category.id %>/edit" class="admin-btn-sm secondary">Éditer</a>
                        <form method="POST" action="/admin/categories/<%= category.id %>?_method=DELETE">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
<button class="admin-btn-sm danger" data-confirm="Supprimer cette catégorie ?">Supprimer</button></form>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <%- include('partials/pagination', { pagination, baseUrl }) %>

      </div>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>

  </body>
</html>
