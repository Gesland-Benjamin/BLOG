<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>Gestion des catégories</h1>
          <a href="/admin/categories/new" class="admin-btn primary">Ajouter une catégorie</a>
        </div>

        <% if (message) { %>
          <div class="admin-alert <%= message.type === 'success' ? 'success' : 'error' %>" role="alert">
            <%= message.text %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <div class="admin-table-card">
          <% if (categories.length === 0) { %>
            <div class="admin-empty-state">
              <p>Aucune catégorie n'existe encore.</p>
              <a href="/admin/categories/new" class="admin-btn primary">Créer une catégorie</a>
            </div>
          <% } else { %>
            <div class="admin-table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Nom</th>
                    <th class="text-center">Articles</th>
                    <th class="text-end">Actions</th>
                  </tr>
                </thead>
                <tbody>
                  <% categories.forEach(category => { %>
                    <tr>
                      <td class="admin-table-name">
                        <span style="color:#1a0c00 !important; font-weight:700; display:inline-block;">
                          <%= category.name || category.nom %>
                        </span>
                      </td>
                      <td class="text-center">
                        <span class="admin-badge secondary"><%= category.articleCount %></span>
                      </td>
                      <td class="text-end">
                        <a href="/admin/categories/<%= category.id %>/edit" class="admin-btn-sm secondary">Éditer</a>
                        <button class="admin-btn-sm danger" onclick="deleteCategory('<%= category.id %>', '<%= category.name || category.nom %>')">Supprimer</button>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>

        <%- include('partials/pagination', { pagination, baseUrl }) %>

      </div>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      function deleteCategory(categoryId, categoryName) {
        console.log('Suppression demandée pour:', categoryId, categoryName);
        if (confirm(`Êtes-vous sûr de vouloir supprimer la catégorie "${categoryName}" ?`)) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/categories/${categoryId}?_method=DELETE`;
          form.onsubmit = function(e) {
            console.log('Formulaire suppression envoyé:', form.action);
          };
          document.body.appendChild(form);
          console.log('Formulaire créé, prêt à être soumis:', form.action);
          form.submit();
        } else {
          alert('Suppression annulée');
        }
      }
      // Debug réseau
      window.addEventListener('load', function() {
        document.querySelectorAll('.admin-btn-sm.danger').forEach(function(btn) {
          btn.addEventListener('click', function() {
            setTimeout(function() {
              fetch(window.location.href, { method: 'HEAD' })
                .then(resp => console.log('Debug HEAD:', resp.status, resp.statusText))
                .catch(err => console.error('Erreur réseau:', err));
            }, 500);
          });
        });
      });
    </script>
  </body>
</html>
