<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>Gestion des médias</h1>
          <% if (orphanMedia.length > 0) { %>
            <button class="admin-btn danger" onclick="cleanOrphans()">Nettoyer les fichiers orphelins</button>
          <% } %>
        </div>

        <% if (message) { %>
          <div class="admin-alert <%= message.type === 'success' ? 'success' : 'error' %>" role="alert">
            <%= message.text %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
          </div>
        <% } %>

        <!-- Statistiques -->
        <div class="admin-stats-grid">
          <div class="admin-stat-card">
            <div class="admin-stat-label">Fichiers utilisés</div>
            <div class="admin-stat-value"><%= usedMedia.length %></div>
          </div>
          <div class="admin-stat-card warning">
            <div class="admin-stat-label">Fichiers orphelins</div>
            <div class="admin-stat-value"><%= orphanMedia.length %></div>
          </div>
          <div class="admin-stat-card">
            <div class="admin-stat-label">Espace total</div>
            <div class="admin-stat-value-text"><%= (totalSize / 1024 / 1024).toFixed(2) %> MB</div>
          </div>
          <div class="admin-stat-card danger">
            <div class="admin-stat-label">À libérer</div>
            <div class="admin-stat-value-text"><%= (orphanSize / 1024 / 1024).toFixed(2) %> MB</div>
          </div>
        </div>

        <!-- Fichiers utilisés -->
        <div class="admin-table-card">
          <div class="admin-table-header">
            <h5>Fichiers utilisés (<%= usedMedia.length %>)</h5>
          </div>
          <% if (usedMedia.length === 0) { %>
            <div class="admin-empty-state">
              Aucun fichier utilisé
            </div>
          <% } else { %>
            <div class="admin-table-responsive">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Nom du fichier</th>
                    <th class="text-end">Taille</th>
                    <th>Date</th>
                    <th class="text-end">Utilisé par</th>
                  </tr>
                </thead>
                <tbody>
                  <% usedMedia.forEach(media => { %>
                    <tr>
                      <td class="admin-table-filename"><%= media.filename %></td>
                    <td class="text-end"><%= media.sizeFormatted %></td>
                    <td><%= media.createdAtFormatted %></td>
                    <td class="text-end">
                      <a href="/article/<%= media.articleId %>" class="btn btn-sm btn-outline-primary">Voir article</a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Fichiers orphelins -->
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
          <h5 class="mb-0">Fichiers orphelins (<%= orphanMedia.length %>)</h5>
          <% if (orphanMedia.length > 0) { %>
            <small class="text-danger"><%= (orphanSize / 1024 / 1024).toFixed(2) %> MB à libérer</small>
          <% } %>
        </div>
        <% if (orphanMedia.length === 0) { %>
          <div class="card-body text-muted text-center py-4">
            Aucun fichier orphelin
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead class="table-light">
                <tr>
                  <th>Nom du fichier</th>
                  <th class="text-end">Taille</th>
                  <th>Date</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% orphanMedia.forEach(media => { %>
                  <tr>
                    <td class="font-monospace small"><%= media.filename %></td>
                    <td class="text-end"><%= media.sizeFormatted %></td>
                    <td><%= media.createdAtFormatted %></td>
                    <td class="text-end">
                      <button class="btn btn-sm btn-outline-danger" onclick="deleteFile('<%= media.filename %>')">Supprimer</button>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      function deleteFile(filename) {
        if (confirm(`Êtes-vous sûr de vouloir supprimer le fichier "${filename}" ?`)) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = `/admin/medias/${filename}?_method=DELETE`;
          document.body.appendChild(form);
          form.submit();
        }
      }

      function cleanOrphans() {
        if (confirm('Êtes-vous sûr de vouloir supprimer tous les fichiers orphelins ? Cette action est irréversible.')) {
          const form = document.createElement('form');
          form.method = 'POST';
          form.action = '/admin/medias/clean-orphans';
          document.body.appendChild(form);
          form.submit();
        }
      }
    </script>
  </body>
</html>
