<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { includeNavbar: true }) %>
    <main class="error-wrapper">
      <div class="error-container">
        <div class="error-content">
          <h1 class="error-code code-404">404</h1>
          <h2 class="error-title">Page introuvable</h2>
          <p class="error-description">
            Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
          </p>
          <div class="error-actions">
            <a href="/" class="btn-general">Retour à l'accueil</a>
            <a href="/search" class="btn-general">Rechercher</a>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
