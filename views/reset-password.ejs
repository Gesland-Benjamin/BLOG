<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header') %>
    <main class="container" style="margin-top: 60px;">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-5">
              <h2 class="text-center mb-4">Nouveau mot de passe</h2>

              <% if (!isValid) { %>
                <div class="alert alert-danger" role="alert">
                  <strong>⚠️ Lien expiré</strong>
                  <p><%= error %></p>
                  <p>Vous pouvez <a href="/auth/forgot">demander un nouveau lien</a>.</p>
                </div>
              <% } else { %>

                <% if (error) { %>
                  <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div>
                <% } %>

                <% if (errors && errors.length > 0) { %>
                  <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <ul class="mb-0">
                      <% errors.forEach(err => { %>
                        <li><%= err %></li>
                      <% }) %>
                    </ul>
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div>
                <% } %>

                <form method="POST" action="/auth/reset/<%= token %>">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="mb-3">
                    <label for="password" class="form-label">Nouveau mot de passe</label>
                    <input
                      type="password"
                      class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('mot de passe'))) ? 'is-invalid' : '' %>"
                      id="password"
                      name="password"
                      required
                      placeholder="Minimum 8 caractères"
                      minlength="8"
                    />
                    <small class="form-text text-muted d-block mt-1">
                      Minimum 8 caractères avec majuscule, minuscule et chiffre.
                    </small>
                  </div>

                  <div class="mb-3">
                    <label for="password_confirm" class="form-label">Confirmer le mot de passe</label>
                    <input
                      type="password"
                      class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('correspondent'))) ? 'is-invalid' : '' %>"
                      id="password_confirm"
                      name="password_confirm"
                      required
                      placeholder="Répétez votre mot de passe"
                      minlength="8"
                    />
                  </div>

                  <button type="submit" class="btn btn-bd-primary w-100">
                    Réinitialiser mon mot de passe
                  </button>
                </form>

              <% } %>

              <hr class="my-4">

              <p class="text-center mb-0">
                <a href="/auth">Retour à la connexion</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <script src="../../assets/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
