<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="auth-wrapper">
      <div class="auth-container">
        <div class="auth-form-card">
          <h2>Nouveau mot de passe</h2>

          <% if (!isValid) { %>
            <div class="auth-alert error">
              <strong>⚠️ Lien expiré</strong>
              <p><%= error %></p>
              <p>Vous pouvez <a href="/auth/forgot">demander un nouveau lien</a>.</p>
            </div>
          <% } else { %>

            <% if (error) { %>
              <div class="auth-alert error"><%= error %></div>
            <% } %>

            <% if (errors && errors.length > 0) { %>
              <div class="auth-alert error">
                <ul>
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>

            <form method="POST" action="/auth/reset/<%= token %>" class="auth-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="auth-form-group">
                <label for="password">Nouveau mot de passe</label>
                <input
                  type="password"
                  id="password"
                  name="password"
                  required
                  placeholder="Minimum 8 caractères"
                  minlength="8"
                />
                <small>
                  Minimum 8 caractères avec majuscule, minuscule et chiffre.
                </small>
              </div>

              <div class="auth-form-group">
                <label for="password_confirm">Confirmer le mot de passe</label>
                <input
                  type="password"
                  id="password_confirm"
                  name="password_confirm"
                  required
                  placeholder="Répétez votre mot de passe"
                  minlength="8"
                />
              </div>

              <button type="submit" class="auth-submit-btn">
                Réinitialiser mon mot de passe
              </button>
            </form>

          <% } %>

          <div class="auth-divider">OU</div>

          <p class="auth-footer">
            <a href="/auth">Retour à la connexion</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
