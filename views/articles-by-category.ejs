<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="content-container">
        <h1 class="page-title">Articles — <%= categorie %></h1>

        <% if (!articles || articles.length === 0) { %>
          <p class="no-articles-message">Aucun article trouvé<%= search ? ' pour cette recherche' : ' pour cette catégorie' %>.</p>
        <% } else { %>
          <div class="archive-articles">
            <% articles.forEach(function(article) { %>
              <% if (article.titre && article.titre.trim() !== '' && article.contenu && article.contenu.trim() !== '') { %>
                <article class="archive-article-card">
                  <div class="archive-article-layout">
                    <% if (article.image) { %>
                      <div class="archive-article-image">
                        <img 
                          src="<%= article.image %>" 
                          alt="<%= article.image_alt || article.titre %>"
                        />
                      </div>
                    <% } %>
                    <div class="archive-article-content <%= article.image ? '' : 'full-width' %>">
                      <h2 class="archive-article-title">
                        <a href="/article/<%= article.id %>">
                          <%= article.titre %>
                        </a>
                      </h2>
                      <p class="archive-article-meta">
                        <strong><%= article.categorie || 'Non catégorisé' %></strong> | 
                        <%= new Date(article.date_publication).toLocaleDateString('fr-FR', { 
                          year: 'numeric', 
                          month: 'long', 
                          day: 'numeric' 
                        }) %>
                      </p>
                      <p class="archive-article-excerpt"><%= (article.contenu || '').substring(0, 200) %>...</p>
                      <a href="/article/<%= article.id %>" class="archive-article-btn">
                        Lire la suite →
                      </a>
                      <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                        <div class="archive-article-admin-actions">
                          <a href="/admin/articles/<%= article.id %>/edit" class="btn-general">Modifier</a>
                          <button class="admin-btn danger" onclick="deleteArticle(<%= article.id %>)">Supprimer</button>
                        </div>
                      <% } %>
                    </div>
                  </div>
                </article>
              <% } %>
            <% }) %>
          </div>
        <% } %>

      <%- include('partials/pagination', { pagination, baseUrl }) %>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      function deleteArticle(articleId) {
        if (confirm('Êtes-vous sûr de vouloir supprimer cet article ?')) {
          fetch(`/admin/articles/${articleId}`, {
            method: 'DELETE',
            headers: {
              'x-csrf-token': '<%= csrfToken %>'
            }
          })
          .then(response => {
            if (response.ok) {
              alert('Article supprimé avec succès');
              location.reload();
            } else {
              alert('Erreur lors de la suppression de l\'article');
            }
          })
          .catch(error => {
            console.error('Erreur:', error);
            alert('Erreur lors de la suppression');
          });
        }
      }
    </script>
  </body>
</html>
