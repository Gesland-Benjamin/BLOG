<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="container" style="margin-top:60px;">
      <h1 class="mb-4">Articles — <%= categorie %></h1>



      <% if (!articles || articles.length === 0) { %>
        <p>Aucun article trouvé<%= search ? ' pour cette recherche' : ' pour cette catégorie' %>.</p>
      <% } else { %>
        <div class="row g-4">
          <% articles.forEach(function(article) { %>
            <div class="col-md-6 d-flex mb-4">
              <div class="card shadow-sm">
                <% if (article.image) { %>
                  <div class="card-img-top bg-light rounded-top" style="height: 200px; overflow: hidden;">
                    <img 
                      src="<%= article.image %>" 
                      alt="<%= article.image_alt || article.titre %>"
                      title="<%= article.titre %>"
                      class="w-100 h-100 object-fit-cover"
                      loading="lazy"
                      srcset="<%= article.image %> 300w, <%= article.image.replace('_sm', '_md') %> 600w"
                      sizes="(max-width: 768px) 100vw, 50vw"
                    >
                  </div>
                <% } %>
                <div class="card-body">
                  <h5 class="card-title"><%= article.titre %></h5>
                  <p class="card-text"><%= (article.contenu || '').substring(0, 200) %>...</p>
                  <small>Par <%= article.auteur %> — <%= new Date(article.date_publication).toLocaleDateString() %></small>
                  <br>
                  <div class="mt-2">
                    <a href="/article/<%= article.id %>" class="btn btn-primary btn-sm">Lire l'article</a>
                    <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                      <a href="/admin/articles/<%= article.id %>/edit" class="btn btn-warning btn-sm">Modifier</a>
                      <button class="btn btn-danger btn-sm" onclick="deleteArticle(<%= article.id %>)">Supprimer</button>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>

      <%- include('partials/pagination', { pagination, baseUrl }) %>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      function deleteArticle(articleId) {
        if (confirm('Êtes-vous sûr de vouloir supprimer cet article ?')) {
          fetch(`/admin/articles/${articleId}`, {
            method: 'DELETE',
            headers: {
              'x-csrf-token': '<%= csrfToken %>'
            }
          })
          .then(response => {
            if (response.ok) {
              alert('Article supprimé avec succès');
              location.reload();
            } else {
              alert('Erreur lors de la suppression de l\'article');
            }
          })
          .catch(error => {
            console.error('Erreur:', error);
            alert('Erreur lors de la suppression');
          });
        }
      }
    </script>
  </body>
</html>
