<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header-article') %>
    <main class="container" style="margin-top:60px;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Modération des commentaires</h1>
        <a href="/article" class="btn btn-outline-secondary">Voir les articles</a>
      </div>

      <div class="table-responsive shadow-sm">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>Article</th>
              <th>Auteur</th>
              <th>Contenu</th>
              <th>Statut</th>
              <th>Spam</th>
              <th>Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (comments.length === 0) { %>
              <tr><td colspan="7" class="text-center text-muted py-4">Aucun commentaire</td></tr>
            <% } %>
            <% comments.forEach(c => { %>
              <tr>
                <td style="max-width:220px;">
                  <% if (c.article) { %>
                    <a href="/article/<%= c.article.id %>"><%= c.article.titre %></a>
                  <% } else { %>
                    <span class="text-muted">Article supprimé</span>
                  <% } %>
                </td>
                <td style="max-width:160px;">
                  <strong><%= c.nom || (c.user ? c.user.nom_prenom : 'Lecteur') %></strong>
                  <% if (c.user) { %><div class="text-muted small">(utilisateur)</div><% } %>
                </td>
                <td style="max-width:320px;"><%= c.contenu %></td>
                <td>
                  <% if (c.statut === 'approved') { %>
                    <span class="badge text-bg-success">Approuvé</span>
                  <% } else if (c.statut === 'pending') { %>
                    <span class="badge text-bg-warning text-dark">En attente</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary">Rejeté</span>
                  <% } %>
                </td>
                <td>
                  <% if (c.is_spam) { %>
                    <span class="badge text-bg-danger">Spam</span>
                  <% } %>
                </td>
                <td><small class="text-muted"><%= new Date(c.date).toLocaleDateString() %></small></td>
                <td class="text-end">
                  <div class="btn-group" role="group">
                    <form method="POST" action="/admin/commentaires/<%= c.id %>/approve" class="me-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-success" type="submit">Approuver</button>
                    </form>
                    <form method="POST" action="/admin/commentaires/<%= c.id %>/reject" class="me-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-secondary" type="submit">Rejeter</button>
                    </form>
                    <form method="POST" action="/admin/commentaires/<%= c.id %>/spam" class="me-1">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-danger" type="submit">Spam</button>
                    </form>
                    <form method="POST" action="/admin/commentaires/<%= c.id %>?_method=DELETE">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Supprimer ce commentaire ?');">Supprimer</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <%- include('partials/pagination', { pagination, baseUrl }) %>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
