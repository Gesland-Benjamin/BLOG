<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header-article') %>
    <main class="container" style="margin-top:60px;">
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3">Modération des commentaires</h1>
        <a href="/article" class="btn btn-outline-secondary">Voir les articles</a>
      </div>

      <% if (comments.length === 0) { %>
        <div class="alert alert-info">Aucun commentaire</div>
      <% } %>

      <% comments.forEach(c => { %>
        <div class="card shadow-sm mb-3">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <h6 class="mb-1">
                  <strong><%= c.nom || (c.user ? c.user.nom_prenom : 'Lecteur') %></strong>
                  <% if (c.user) { %><span class="badge text-bg-info ms-2">Utilisateur</span><% } %>
                  <% if (c.statut === 'approved') { %>
                    <span class="badge text-bg-success ms-2">Approuvé</span>
                  <% } else if (c.statut === 'pending') { %>
                    <span class="badge text-bg-warning text-dark ms-2">En attente</span>
                  <% } else { %>
                    <span class="badge text-bg-secondary ms-2">Rejeté</span>
                  <% } %>
                  <% if (c.is_spam) { %>
                    <span class="badge text-bg-danger ms-2">Spam</span>
                  <% } %>
                </h6>
                <small class="text-muted">
                  <% if (c.article) { %>
                    Article: <a href="/article/<%= c.article.id %>"><%= c.article.titre %></a> •
                  <% } %>
                  <%= new Date(c.date).toLocaleString('fr-FR') %>
                </small>
              </div>
            </div>
            
            <p class="mb-3"><%= c.contenu %></p>

            <!-- Actions du commentaire -->
            <div class="d-flex gap-2 flex-wrap">
              <form method="POST" action="/admin/commentaires/<%= c.id %>/approve" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-success" type="submit">✓ Approuver</button>
              </form>
              <form method="POST" action="/admin/commentaires/<%= c.id %>/reject" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-secondary" type="submit">✗ Rejeter</button>
              </form>
              <form method="POST" action="/admin/commentaires/<%= c.id %>/spam" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-danger" type="submit">🚫 Spam</button>
              </form>
              <button class="btn btn-sm btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#reply-form-<%= c.id %>">
                💬 Répondre
              </button>
              <form method="POST" action="/admin/commentaires/<%= c.id %>?_method=DELETE" class="d-inline">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Supprimer ce commentaire ?');">🗑️ Supprimer</button>
              </form>
            </div>

            <!-- Formulaire de réponse (collapsé) -->
            <div class="collapse mt-3" id="reply-form-<%= c.id %>">
              <form method="POST" action="/admin/commentaires/<%= c.id %>/reply" class="bg-light p-3 rounded">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-2">
                  <label for="contenu-<%= c.id %>" class="form-label fw-bold">Votre réponse</label>
                  <textarea class="form-control" id="contenu-<%= c.id %>" name="contenu" rows="3" required placeholder="Écrivez votre réponse..."></textarea>
                </div>
                <div class="d-flex gap-2">
                  <button type="submit" class="btn btn-sm btn-primary">Envoyer la réponse</button>
                  <button type="button" class="btn btn-sm btn-secondary" data-bs-toggle="collapse" data-bs-target="#reply-form-<%= c.id %>">Annuler</button>
                </div>
              </form>
            </div>

            <!-- Affichage des réponses -->
            <% if (c.replies && c.replies.length > 0) { %>
              <div class="mt-3 pt-3 border-top">
                <h6 class="mb-3">
                  <span class="badge text-bg-secondary"><%= c.replies.length %></span> 
                  Réponse<%= c.replies.length > 1 ? 's' : '' %>
                </h6>
                
                <% if (c.replies.length <= 3) { %>
                  <!-- Afficher toutes les réponses si 3 ou moins -->
                  <% c.replies.forEach(reply => { %>
                    <div class="ms-4 mb-2 p-2 bg-light rounded">
                      <div class="d-flex justify-content-between align-items-start">
                        <small class="fw-bold text-primary">
                          <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                          <% if (reply.is_admin_reply) { %>
                            <span class="badge text-bg-primary" style="font-size:0.7rem;">ADMIN</span>
                          <% } %>
                        </small>
                        <small class="text-muted"><%= new Date(reply.date).toLocaleString('fr-FR') %></small>
                      </div>
                      <p class="mb-0 mt-1"><%= reply.contenu %></p>
                    </div>
                  <% }) %>
                <% } else { %>
                  <!-- Menu déroulant si plus de 3 réponses -->
                  <div class="accordion" id="accordion-<%= c.id %>">
                    <div class="accordion-item">
                      <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-<%= c.id %>">
                          Voir les <%= c.replies.length %> réponses
                        </button>
                      </h2>
                      <div id="collapse-<%= c.id %>" class="accordion-collapse collapse" data-bs-parent="#accordion-<%= c.id %>">
                        <div class="accordion-body">
                          <% c.replies.forEach(reply => { %>
                            <div class="ms-4 mb-2 p-2 bg-light rounded">
                              <div class="d-flex justify-content-between align-items-start">
                                <small class="fw-bold text-primary">
                                  <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                                  <% if (reply.is_admin_reply) { %>
                                    <span class="badge text-bg-primary" style="font-size:0.7rem;">ADMIN</span>
                                  <% } %>
                                </small>
                                <small class="text-muted"><%= new Date(reply.date).toLocaleString('fr-FR') %></small>
                              </div>
                              <p class="mb-0 mt-1"><%= reply.contenu %></p>
                            </div>
                          <% }) %>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>
        </div>
      <% }) %>

      <%- include('partials/pagination', { pagination, baseUrl }) %>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
