<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="admin-wrapper admin-commentaires">
      <div class="admin-container">
        <div class="admin-header moderation-heading">
          <div><h1>Modération des commentaires</h1><p>Lisez, répondez et choisissez les échanges à publier.</p></div>
          <a href="/admin/dashboard" class="btn-general">Tableau de bord</a>
          <form method="GET" action="/admin/commentaires" class="admin-search-form moderation-search">
            <label class="visually-hidden" for="comment-search">Rechercher un auteur ou un passage</label>
            <input id="comment-search" type="search" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Nom ou contenu du commentaire" class="admin-input">
            <button type="submit" class="btn-general">Rechercher</button>
            <% if (typeof search !== 'undefined' && search) { %><a href="/admin/commentaires" class="btn-general secondary">Effacer le filtre</a><% } %>
          </form>
        </div>
        <% if (comments.length === 0) { %><div class="admin-alert info">Aucun commentaire<%= typeof search !== 'undefined' && search ? ' ne correspond à votre recherche' : ' pour le moment' %>.</div><% } %>
        <div class="admin-comments-grid">
          <% comments.forEach(c => { const text = c.content || c.contenu || ''; const created = c.created_at || c.date; const date = created ? new Date(created) : null; %>
            <article class="admin-comment-card moderation-card" id="comment-<%= c.id %>">
              <div class="moderation-card-heading">
                <h2><%= c.name || c.nom || c.user?.name || 'Lecteur' %></h2>
                <span class="admin-badge <%= c.statut === 'approved' ? 'success' : c.statut === 'pending' ? 'warning' : 'secondary' %>"><%= c.statut === 'approved' ? 'Publié' : c.statut === 'pending' ? 'En attente' : 'Refusé' %></span>
                <% if (c.is_spam) { %><span class="admin-badge danger">Spam</span><% } %>
              </div>
              <div class="admin-comment-meta">
                <% if (c.article) { %>
                  Sur <a href="<%= c.article.is_published === false ? '/admin/articles/' + c.article.id + '/edit' : articlePath(c.article) %>"><%= c.article.title || c.article.titre %></a>
                <% } else { %>Article indisponible<% } %>
                <% if (date && !Number.isNaN(date.getTime())) { %><time datetime="<%= date.toISOString() %>"><%= date.toLocaleString('fr-FR') %></time><% } %>
              </div>
              <p class="admin-comment-content"><%= text.length > 500 ? text.slice(0, 500) + '…' : text %></p>
              <% if (text.length > 500) { %><details class="moderation-full-text"><summary>Lire le commentaire entier</summary><p><%= text %></p></details><% } %>
              <div class="moderation-primary-actions">
                <% if (c.statut !== 'approved') { %><form method="POST" action="/admin/commentaires/<%= c.id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn-sm success" type="submit">Approuver</button></form><% } %>
                <% if (c.statut !== 'rejected') { %><form method="POST" action="/admin/commentaires/<%= c.id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn-sm secondary" type="submit">Refuser</button></form><% } %>
              </div>
              <%- include('partials/admin-comment-reply', { comment: c }) %>
              <details class="moderation-other-actions"><summary>Autres actions</summary><div class="moderation-primary-actions">
                <% if (!c.is_spam) { %><form method="POST" action="/admin/commentaires/<%= c.id %>/spam"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn-sm secondary" type="submit">Marquer comme spam</button></form><% } %>
                <form method="POST" action="/admin/commentaires/<%= c.id %>?_method=DELETE"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="admin-btn-sm danger" type="submit" data-confirm="Supprimer définitivement ce commentaire ?">Supprimer</button></form>
              </div></details>
              <% if (c.replies?.length) { %><details class="moderation-thread"><summary><%= c.replies.length %> réponse<%= c.replies.length > 1 ? 's' : '' %></summary>
                <% c.replies.forEach(reply => { %><div class="moderation-thread-item"><strong><%= reply.name || reply.nom || reply.user?.name || 'Lecteur' %></strong><% if (reply.is_admin_reply) { %> <span class="admin-badge info">Équipe du blog</span><% } %><p><%= reply.content || reply.contenu %></p></div><% }) %>
              </details><% } %>
            </article>
          <% }) %>
        </div>
        <%- include('partials/pagination', { pagination, baseUrl }) %>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
