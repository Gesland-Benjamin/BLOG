<!-- Script de test universel pour debug dropdown mobile (log + couleur) -->
<script>
window.addEventListener('load', function() {
  console.log('Script de test chargé !');
  setTimeout(function() {
    var found = false;
    document.querySelectorAll('.dropdown-toggle').forEach(function(btn) {
      found = true;
      console.log('Bouton dropdown trouvé :', btn.id || btn.className);
      btn.addEventListener('click', function() {
        this.style.background = '#ff4444';
        this.style.color = '#fff';
        console.log('Événement JS capté sur le bouton :', this.id || this.className);
      });
    });
    if (!found) {
      console.warn('Aucun bouton .dropdown-toggle trouvé dans le DOM !');
    }
  }, 200);
});
</script>
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>

<!-- Désactive le dropdown Bootstrap pour éviter les conflits -->
<script>
  if (window.bootstrap && window.bootstrap.Dropdown) {
    window.bootstrap.Dropdown = function() {};
  }
</script>

<!-- Scripts personnalisés (versionné pour forcer le rechargement) -->
<script src="/js/dropdown.js?v=<%= Date.now() %>"></script>

<!-- Carrousel: défilement gauche -> droite -->
<script>
(function() {
  function initCarousel() {
    var carouselEl = document.getElementById('mixedCarousel');
    if (!carouselEl) return;

    var items = carouselEl.querySelectorAll('.carousel-item');
    if (items.length <= 1) return;

    if (window.bootstrap && window.bootstrap.Carousel) {
      var carousel = window.bootstrap.Carousel.getOrCreateInstance(carouselEl, {
        interval: false,
        ride: false,
        wrap: true,
        touch: true,
        keyboard: true
      });

      setInterval(function() {
        carousel.prev();
      }, 5000);
      return;
    }

    var currentIndex = 0;

    function showSlide(index) {
      items.forEach(function(item, i) {
        item.classList.toggle('active', i === index);
      });
    }

    setInterval(function() {
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      showSlide(currentIndex);
    }, 5000);
  }
  
  // Attendre que le DOM soit prêt
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
})();
</script>