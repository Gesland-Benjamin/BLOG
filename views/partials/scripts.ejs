<!-- Bootstrap gère seul les menus, accordéons et alertes. -->
<script src="/jss/bootstrap.bundle.min.js"></script>
<script src="/js/dropdown.js?v=2"></script>

<!-- Carrousel: défilement gauche -> droite -->
<script>
(function() {
  function initCarousel() {
    var carouselEl = document.getElementById('mixedCarousel');
    if (!carouselEl) return;

    var items = carouselEl.querySelectorAll('.carousel-item');
    if (items.length <= 1) return;

    if (window.bootstrap && window.bootstrap.Carousel) {
      var carousel = window.bootstrap.Carousel.getOrCreateInstance(carouselEl, {
        interval: false,
        ride: false,
        wrap: true,
        touch: true,
        keyboard: true
      });

      setInterval(function() {
        if (!document.hidden && !document.querySelector('header .dropdown-menu.show')) {
          carousel.prev();
        }
      }, 5000);
      return;
    }

    var currentIndex = 0;

    function showSlide(index) {
      items.forEach(function(item, i) {
        item.classList.toggle('active', i === index);
      });
    }

    setInterval(function() {
      if (document.hidden || document.querySelector('header .dropdown-menu.show')) return;
      currentIndex = (currentIndex - 1 + items.length) % items.length;
      showSlide(currentIndex);
    }, 5000);
  }
  
  // Attendre que le DOM soit prêt
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCarousel);
  } else {
    initCarousel();
  }
})();
</script>