<footer class="footer-wrapper">
  <div class="footer-container">
    <!-- Newsletter Signup -->
    <div class="footer-newsletter">
      <span class="newsletter-eyebrow">Gardons le lien</span>
      <h2>Les nouvelles d’Emi’Pulse</h2>
      <p class="footer-newsletter-intro">Retrouvez les nouveaux articles et les actualités du blog dans votre boîte mail.</p>
      <form action="/newsletter/subscribe" method="POST" class="newsletter-form">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="visually-hidden" for="footer-newsletter-email">Votre adresse e-mail</label>
        <input id="footer-newsletter-email" autocomplete="email" inputmode="email" maxlength="150" aria-describedby="footer-newsletter-help"
          type="email" 
          name="email" 
          placeholder="Votre adresse email" 
          required
          class="newsletter-input"
        />
        <button type="submit" class="newsletter-btn">Je m’inscris <span aria-hidden="true">→</span></button>
      </form>
      <p id="footer-newsletter-help" class="newsletter-fineprint">Inscription à confirmer par e-mail. Désinscription à tout moment.</p>
    </div>

    <!-- Links -->
    <div class="footer-links">
      <ul>
        <li><a href="/renseignements">Renseignements</a></li>
        <li><a href="/mentions-legales">Mentions légales</a></li>
      </ul>
    </div>
  </div>

  <!-- Copyright -->
  <div class="footer-copyright-section">
    <div class="footer-copyright-mobile-row">
      <p class="footer-copyright-text">© Emi'Pulse - 2025</p>
      <a class="social-icon social-icon-yt footer-youtube-mobile d-inline-flex d-sm-none" href="https://www.youtube.com/@TeamPulseFarmasiFrance" target="_blank" rel="noopener" aria-label="YouTube">
        <i class="bi bi-youtube"></i>
      </a>
    </div>
  </div>
</footer>





