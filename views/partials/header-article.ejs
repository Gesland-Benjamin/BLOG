 <header class="border-bottom lh-1 py-3">
      <div class="container">
        <div class="row flex-nowrap justify-content-between align-items-center">
          <div class="col-4 pt-1">
            <a class="btn btn-sm btn-outline-secondary" href="/newsletter">Newsletter</a>
          </div>
          <div class="col-4 text-center">
            <a class="blog-header-logo text-body-emphasis text-decoration-none" href="/">Titre</a>
          </div>
          <div class="col-4 d-flex justify-content-end align-items-center gap-2">
            <a class="link-secondary" href="/search" aria-label="Search">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" class="mx-3" role="img" viewBox="0 0 24 24">
                <title>Search</title>
                <circle cx="10.5" cy="10.5" r="7.5"></circle>
                <path d="M21 21l-5.2-5.2"></path>
              </svg>
            </a>
            <% if (typeof user !== 'undefined' && user && user.role === "admin") { %>
              <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center" type="button" id="adminMenuDropdownArticle" data-bs-toggle="dropdown" aria-expanded="false">
                  Dashboard
                  <span class="ms-2" aria-hidden="true">|||</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminMenuDropdownArticle">
                  <li><a class="dropdown-item" href="/admin/dashboard">Dashboard</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/admin/articles/new">Ajouter un article</a></li>
                  <li><a class="dropdown-item" href="/admin/newsletter">📧 Newsletter</a></li>
                  <li><hr class="dropdown-divider"></li>
                  <li><a class="dropdown-item" href="/admin/articles/new">Ajouter un article</a></li>
                  <li><a class="dropdown-item" href="/admin/categories">Gérer les catégories</a></li>
                  <li><a class="dropdown-item" href="/admin/medias">Gérer les médias</a></li>
                  <li><a class="dropdown-item" href="/admin/commentaires">Modérer les commentaires</a></li>
                </ul>
              </div>
            <% } %>
            <% if (typeof user !== 'undefined' && user) { %>
              <a class="btn btn-sm btn-outline-secondary" href="/auth/logout">Déconnexion</a>
            <% } else { %>
              <a class="btn btn-sm btn-outline-secondary" href="/auth">Se connecter / S'inscrire</a>
            <% } %>
          </div>
        </div>
      </div>
    </header>