<header class="border-bottom lh-1 py-3">
        <div class="row flex-nowrap justify-content-between align-items-center">
          <div class="col-4 pt-1">
            <a class="btn btn-sm btn-outline-secondary" href="/newsletter">Newsletter</a>
          </div>
          <div class="col-4 text-center">
            <a
              class="blog-header-logo text-body-emphasis text-decoration-none"
              href="/"
              >Titre</a
            >
          </div>
          <div class="col-4 d-flex justify-content-end align-items-center gap-2">
            <a class="link-secondary" href="#" aria-label="Search">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                class="mx-3"
                role="img"
                viewBox="0 0 24 24"
              >
                <title>Search</title>
                <circle cx="10.5" cy="10.5" r="7.5"></circle>
                <path d="M21 21l-5.2-5.2"></path>
              </svg>
            </a>
            <% if (user && user.role === "admin") { %>
              <div class="dropdown">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center" type="button" id="adminMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                  Dashboard
                  <span class="ms-2" aria-hidden="true">|||</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminMenuDropdown">
                  <li><a class="dropdown-item" href="/admin/articles/new">Ajouter un article</a></li>
                </ul>
              </div>
            <% } %>
               <% if (user) { %>
          <a class="btn btn-sm btn-outline-secondary" href="/auth/logout">Déconnexion</a>
     <% } else { %>
          <a class="btn btn-sm btn-outline-secondary" href="/auth">Connexion</a>
     <% } %>
          </div>
        </div>
      </header>