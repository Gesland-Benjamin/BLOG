<header-wrapper>
  <header>
    <% const showNavbar = typeof includeNavbar !== 'undefined' ? includeNavbar :
    false; const useContainer = typeof withContainer !== 'undefined' ?
    withContainer : false; %>
    <div class="header-content">
      <!-- Gauche: Articles et Boutique -->
      <div class="header-left">
        <div class="dropdown">
          <button
            class="btn dropdown-toggle"
            type="button"
            id="navbarArticleDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
          >
            Articles
          </button>
          <ul class="dropdown-menu" aria-labelledby="navbarArticleDropdown">
            <li>
              <a class="dropdown-item" href="/article/categorie/Beauté">Beauté</a>
            </li>
            <li>
              <a class="dropdown-item" href="/article/categorie/Nutrition"
                >Nutrition</a
              >
            </li>
            <li>
              <a
                class="dropdown-item"
                href="/article/categorie/Développement%20Personnels"
                >Développement Personnels</a
              >
            </li>
          </ul>
        </div>
        <a
          class="btn"
          href="https://fr.farmasi.com/emiliedelbe"
          >Boutique</a
        >
      </div>

      <!-- Centre: Logo + Barre de recherche -->
      <div class="header-center">
        <div class="header-center-content">
          <a class="blog-header-logo" href="/" aria-label="Accueil">
            <span class="logo-text">MI AMOR</span>
          </a>
          <% if (showNavbar) { %>
          <form method="GET" action="/search" class="search-form-center">
            <input
              type="search"
              name="q"
              placeholder="Rechercher..."
              aria-label="Rechercher"
            />
            <button
              type="submit"
              class="btn-search-center"
              aria-label="Rechercher"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                fill="none"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <title>Search</title>
                <circle cx="10.5" cy="10.5" r="7.5"></circle>
                <path d="M21 21l-5.2-5.2"></path>
              </svg>
            </button>
          </form>
          <% } %>
        </div>
      </div>

      <!-- Droite: Connexion/Renseignements -->
      <div class="header-right">
        <% if (typeof user !== 'undefined' && user && user.role === "admin") { %>
        <div class="dropdown gear-dropdown">
          <button
            class="btn-gear"
            type="button"
            id="adminMenuDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Dashboard Admin"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 7l-5 5m0 0l-5-5m5 5v8m3-13h6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
              <path d="M9 11h6M9 15h6"></path>
            </svg>
          </button>
          <ul
            class="dropdown-menu"
            aria-labelledby="adminMenuDropdown"
          >
            <li>
              <a class="dropdown-item" href="/admin/dashboard">Dashboard</a>
            </li>

            <li>
              <a class="dropdown-item" href="/admin/articles/new"
                >Ajouter un article</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/categories"
                >Gérer les catégories</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/medias">Gérer les médias</a>
            </li>
            <li>
              <a class="dropdown-item" href="/admin/commentaires"
                >Modérer les commentaires</a
              >
            </li>
            <li>
              <a class="dropdown-item" href="/admin/newsletter">📧 Newsletter</a>
            </li>
          </ul>
        </div>
        <% } %>
        
        <div class="header-right-buttons">
          <% if (typeof user !== 'undefined' && user) { %>
            <a class="btn" href="/auth/logout"
              >Déconnexion</a
            >
          <% } else { %>
            <a class="btn" href="/auth"
              >se connecter/s'inscrire</a
            >
          <% } %>
          <a class="btn" href="/renseignements"
            >Renseignements</a
          >
        </div>

        <% if (typeof user !== 'undefined' && user) { %>
          <div class="social-icons">
    <a href="https://www.facebook.com/emilie.delbe.3?locale=fr_FR" target="_blank" aria-label="Facebook">
      <i class="bi bi-facebook"></i>
    </a>
    <a href="https://www.instagram.com/emi_delbe/" target="_blank" aria-label="Instagram">
      <i class="bi bi-instagram"></i>
    </a>
  </div>
        <% } %>
      </div>
    </div>
  </header>

  <% if (showNavbar) { %>
  <nav class="navbar-nav">
  </nav>
  <% } %>
</header-wrapper>
