<header-wrapper>
  <header>
     <% const showNavbar = typeof includeNavbar !== 'undefined' ? includeNavbar : true;
       const useContainer = typeof withContainer !== 'undefined' ? withContainer : true; %>
    
    <!-- Logos sociaux en haut à gauche -->
    <div class="header-social-top">
      <a
        class="social-icon social-icon-fb"
        href="https://www.facebook.com/emilie.delbe.3?locale=fr_FR"
        target="_blank"
        rel="noopener"
        aria-label="Facebook"
      >
        <i class="bi bi-facebook"></i>
      </a>
      <a
        class="social-icon social-icon-ig"
        href="https://www.instagram.com/emi_delbe/"
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
      >
        <i class="bi bi-instagram"></i>
      </a>
      <% if (typeof user !== 'undefined' && user && user.role === "admin") { %>
        <div class="dropdown gear-dropdown">
          <button
            class="btn-gear dropdown-toggle stylish-gear-btn"
            type="button"
            id="adminMenuDropdown"
            data-bs-toggle="dropdown"
            aria-expanded="false"
            aria-label="Dashboard Admin"
          >
            <span class="stylish-gear-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="url(#gearGradient)" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <defs>
                  <linearGradient id="gearGradient" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#f29a4a"/>
                    <stop offset="100%" stop-color="#764ba2"/>
                  </linearGradient>
                </defs>
                <circle cx="12" cy="12" r="3" />
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.06a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.06a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.06a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" />
              </svg>
            </span>
          </button>
          <ul
            class="dropdown-menu"
            aria-labelledby="adminMenuDropdown"
          >
            <li>
              <a class="dropdown-item" href="/admin/dashboard"><i class="bi bi-speedometer2 header-icon-spacer"></i>Dashboard</a>
            </li>
            <li>
              <a class="dropdown-item" href="/admin/articles/new"><i class="bi bi-plus-circle header-icon-spacer"></i>Ajouter un article</a>
            </li>
            <li>
              <a class="dropdown-item" href="/admin/categories"><i class="bi bi-tags-fill header-icon-spacer"></i>Gérer les catégories</a>
            </li>
            <li>
              <a class="dropdown-item" href="/admin/newsletter"><i class="bi bi-envelope-check header-icon-spacer"></i>Newsletter</a>
            </li>
          </ul>
        </div>
      <% } %>
    </div>
    
    <div class="<%= useContainer ? 'header-container' : '' %>">
      <div class="header-content">
      <!-- Gauche: Facebook + Articles/Boutique -->
      <div class="header-left">
        <div class="header-left-actions">
          <div class="left-buttons-stack">
            <div class="dropdown">
              <button
                class="btn dropdown-toggle btn-chrome-articles"
                type="button"
                id="navbarArticleDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                title="Articles"
              >
                <span class="visually-hidden">Articles</span>
              </button>
              <ul class="dropdown-menu" aria-labelledby="navbarArticleDropdown">
                <% if (categories && categories.length) { %>
                  <% categories.forEach(cat => { %>
                    <li>
                      <a class="dropdown-item" href="/article/categorie/<%= encodeURIComponent(cat.nom) %>">
                        <i class="bi bi-tag-fill header-icon-spacer"></i><%= cat.nom %>
                      </a>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li><span class="dropdown-item header-text-muted"><i class="bi bi-dash-circle header-icon-spacer"></i>Aucune catégorie</span></li>
                <% } %>
              </ul>
            </div>
            <a
              class="btn-chrome-boutique"
              href="https://fr.farmasi.com/emiliedelbe"
              >Boutique</a
            >
          </div>
        </div>
      </div>

      <!-- Centre: Logo + Barre de recherche -->
      <div class="header-center">
        <div class="header-center-content">
          <a class="blog-header-logo logo-desktop" href="/" aria-label="Accueil">
            <img src="/logo 3.png" alt="Logo" class="logo-img" />
          </a>
          <!-- Version mobile : logo centré avec réseaux à gauche/droite -->
          <div class="mobile-logo-row">
            <a
              class="social-icon social-icon-fb"
              href="https://www.facebook.com/emilie.delbe.3?locale=fr_FR"
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <i class="bi bi-facebook"></i>
            </a>
            <!-- Logo dashboard mobile supprimé -->
            <a
              class="social-icon social-icon-ig"
              href="https://www.instagram.com/emi_delbe/"
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <i class="bi bi-instagram"></i>
            </a>
          </div>
          <% if (showNavbar) { %>
          <div class="header-search-and-actions">
            <form method="GET" action="/search" class="search-form-center header-search-bottom">
              <input
                type="search"
                name="q"
                placeholder="Rechercher..."
                aria-label="Rechercher"
              />
              <button
                type="submit"
                class="btn-search-center"
                aria-label="Rechercher"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="16"
                  height="16"
                  fill="none"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <title>Search</title>
                  <circle cx="10.5" cy="10.5" r="7.5"></circle>
                  <path d="M21 21l-5.2-5.2"></path>
                </svg>
              </button>
            </form>
            <div class="mobile-duo-actions header-actions-bottom">
              <!-- Dropdown Articles (catégories) -->
              <div class="dropdown">
                <button
                  class="btn dropdown-toggle btn-chrome-articles"
                  type="button"
                  id="navbarArticleDropdownMobileBar"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  aria-label="Articles"
                >
                  Articles
                </button>
                <ul class="dropdown-menu header-full-width" aria-labelledby="navbarArticleDropdownMobileBar">
                  <% if (categories && categories.length) { %>
                    <% categories.forEach(cat => { %>
                      <li>
                        <a class="dropdown-item" href="/article/categorie/<%= encodeURIComponent(cat.nom) %>">
                          <i class="bi bi-tag-fill header-icon-spacer"></i><%= cat.nom %>
                        </a>
                      </li>
                    <% }) %>
                  <% } else { %>
                    <li><span class="dropdown-item header-text-muted"><i class="bi bi-dash-circle header-icon-spacer"></i>Aucune catégorie</span></li>
                  <% } %>
                </ul>
              </div>
              <!-- Dropdown Menu (reste des boutons) -->
              <div class="dropdown">
                <button
                  class="btn dropdown-toggle btn-chrome-menu"
                  type="button"
                  id="navbarMoreDropdownMobileBar"
                  data-bs-toggle="dropdown"
                  aria-expanded="false"
                  title="Menu"
                  aria-label="Menu"
                >
                  Menu
                </button>
                <ul class="dropdown-menu header-full-width" aria-labelledby="navbarMoreDropdownMobileBar">
                <li>
                  <a class="dropdown-item" href="https://fr.farmasi.com/emiliedelbe" target="_blank" rel="noopener">
                    <i class="bi bi-bag-heart-fill header-icon-spacer"></i>Boutique
                  </a>
                </li>
                <% if (typeof user !== 'undefined' && user) { %>
                  <li>
                    <a class="dropdown-item" href="/auth/logout">
                      <i class="bi bi-box-arrow-right header-icon-spacer"></i>Déconnexion
                    </a>
                  </li>
                <% } else { %>
                  <li>
                    <a class="dropdown-item" href="/auth">
                      <i class="bi bi-person-circle header-icon-spacer"></i>Se connecter / S'inscrire
                    </a>
                  </li>
                <% } %>
                <li>
                  <a class="dropdown-item" href="/renseignements">
                    <i class="bi bi-info-circle-fill header-icon-spacer"></i>Renseignements
                  </a>
                </li>
                <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
                  <li>
                    <a class="dropdown-item" href="/admin/dashboard">
                      <i class="bi bi-speedometer2 header-icon-spacer"></i>Dashboard
                    </a>
                  </li>
                <% } %>
              </ul>
              </div>
            </div>
          </div>
          <% } %>

        </div>
      </div>

      <!-- Droite: Connexion/Renseignements -->
      <div class="header-right">
        <div class="right-buttons-stack">
          <% if (typeof user !== 'undefined' && user) { %>
            <a class="btn-chrome-deconnexion" href="/auth/logout">
              <i class="bi bi-box-arrow-right header-icon-spacer"></i>Déconnexion
            </a>
          <% } else { %>
            <a class="btn-chrome-connexion" href="/auth">
              <i class="bi bi-person-circle header-icon-spacer"></i>Connexion / Inscription
            </a>
          <% } %>
          <a class="btn-chrome-contactes" href="/renseignements">
            <i class="bi bi-info-circle-fill header-icon-spacer"></i>Contacts
          </a>
        </div>
      </div>
    </div>
    </div>
  </header>

  <% if (showNavbar) { %>
  <nav class="navbar-nav">
  </nav>
  <% } %>
</header-wrapper>
