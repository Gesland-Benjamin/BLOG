<header>
  <% 
    const showNavbar = typeof includeNavbar !== 'undefined' ? includeNavbar : false;
    const useContainer = typeof withContainer !== 'undefined' ? withContainer : false;
  %>
    <div class="row flex-nowrap justify-content-between align-items-center">
      <div class="col-4">
        <form method="GET" action="/search" class="search-form-header">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
            <circle cx="10.5" cy="10.5" r="7.5"></circle>
            <path d="M21 21l-5.2-5.2"></path>
          </svg>
          <input type="search" name="q" placeholder="Rechercher..." aria-label="Rechercher">
        </form>
      </div>
      <div class="col-4 text-center">
        <a class="blog-header-logo" href="/" aria-label="Accueil"></a>
      </div>
      <div class="col-4 d-flex justify-content-end align-items-center gap-2">
        <% if (typeof user !== 'undefined' && user && user.role === "admin") { %>
          <div class="dropdown">
            <button class="btn btn-sm btn-outline-secondary dropdown-toggle d-flex align-items-center" type="button" id="adminMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
              Dashboard
            </button>
            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminMenuDropdown">
              <li><a class="dropdown-item" href="/admin/dashboard">Dashboard</a></li>
              <li><hr class="dropdown-divider"></li>
              <li><a class="dropdown-item" href="/admin/articles/new">Ajouter un article</a></li>
              <li><a class="dropdown-item" href="/admin/categories">Gérer les catégories</a></li>
              <li><a class="dropdown-item" href="/admin/medias">Gérer les médias</a></li>
              <li><a class="dropdown-item" href="/admin/commentaires">Modérer les commentaires</a></li>
              <li><a class="dropdown-item" href="/admin/newsletter">📧 Newsletter</a></li>
            </ul>
          </div>
        <% } %>
        <% if (typeof user !== 'undefined' && user) { %>
          <a class="btn btn-sm btn-outline-secondary" href="/auth/logout">Déconnexion</a>
        <% } else { %>
          <a class="btn btn-sm btn-outline-secondary" href="/auth">se connecter/s'inscrire</a>
        <% } %>
      </div>
    </div>
</header>

<% if (showNavbar) { %>
<div class="py-1 mb-3 border-bottom position-static">
  <nav class="nav nav-underline justify-content-between align-items-center">
    <div class="d-flex gap-3">
      <a class="nav-item nav-link link-body-emphasis active" href="/">Accueil</a>
      <div class="nav-item dropdown">
        <a class="nav-link dropdown-toggle" href="#" id="navbarArticleDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
          Articles
        </a>
        <ul class="dropdown-menu" aria-labelledby="navbarArticleDropdown">
          <li><a class="dropdown-item" href="/article/categorie/Beauté">Beauté</a></li>
          <li><a class="dropdown-item" href="/article/categorie/Nutrition">Nutrition</a></li>
          <li><a class="dropdown-item" href="/article/categorie/Développement%20Personnels">Développement Personnels</a></li>
        </ul>
      </div>
      <a class="nav-item nav-link link-body-emphasis" href="https://fr.farmasi.com/emiliedelbe">Boutique</a>
      <a class="nav-item nav-link link-body-emphasis" href="/renseignements">Renseignements</a>
    </div>
    
    <form method="GET" action="/search" class="search-form-navbar d-flex gap-2">
      <input type="search" name="q" class="form-control form-control-sm" placeholder="Rechercher un article..." aria-label="Rechercher">
      <button type="submit" class="btn btn-sm btn-outline-secondary" aria-label="Rechercher">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
          <title>Search</title>
          <circle cx="10.5" cy="10.5" r="7.5"></circle>
          <path d="M21 21l-5.2-5.2"></path>
        </svg>
      </button>
    </form>
  </nav>
</div>
<% } %>