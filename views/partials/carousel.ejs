<% const _count = (carouselItems || []).length; %> <% if (_count === 0) { %>
<div class="alert alert-secondary">
  Aucun article récent dans Événements ou Nouveautés.
</div>
<% } else { %>
<div
  id="mixedCarousel"
  class="card-bordered"
  data-bs-ride="carousel"
  data-bs-interval="5000"
  data-bs-pause="false"
  data-bs-keyboard="true"
  data-bs-touch="true"
  data-bs-wrap="true"
>
  <div class="carousel-inner">
    <% carouselItems.forEach((item, idx) => { %>
    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
      <div
        class="carousel-article-card row g-0 align-items-stretch"
        style="min-height: 280px; position: relative"
      >
        <div class="col-lg-5 p-4">
          <h1 class="display-6 fst-italic"><%= item.titre %></h1>
          <p class="lead my-3"><%= item.extrait %>...</p>
          <p class="text-muted mb-3">Par <%= item.auteur %></p>
          <p class="lead mb-0">
            <a href="/article/<%= item.id %>" class="text-body-emphasis fw-bold"
              >Lire l'article complet...</a
            >
          </p>
        </div>
        <div class="col-lg-7 p-0 carousel-image-wrapper">
          <% if (item.image) { %>
            <img
              src="<%= item.image %>"
              alt="<%= item.titre %>"
              class="card-bordered"
              style="
                height: 100%;
                width: 100%;
                object-fit: cover;
                display: block;
                border-radius: 0 28px 28px 0;
              "
            />
            <% } else { %>
            <div
              class="bg-body-secondary rounded d-flex align-items-center justify-content-center w-100"
            >
              Aucune image
            </div>
            <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
    <% if (_count > 1) { %>
    <button
      class="carousel-control-prev"
      type="button"
      data-bs-target="#mixedCarousel"
      data-bs-slide="prev"
    >
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Précédent</span>
    </button>
    <button
      class="carousel-control-next"
      type="button"
      data-bs-target="#mixedCarousel"
      data-bs-slide="next"
    >
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Suivant</span>
    </button>
    <div class="carousel-indicators">
      <% carouselItems.forEach((_, i) => { %>
      <button
        type="button"
        data-bs-target="#mixedCarousel"
        data-bs-slide-to="<%= i %>"
        class="<%= i === 0 ? 'active' : '' %>"
        aria-label="Slide <%= i+1 %>"
      ></button>
      <% }) %>
    </div>
    <% } %>
  </div>
  <% } %>
</div>
