<% const _count = (carouselItems || []).length; %> <% if (_count === 0) { %>
<div class="alert alert-secondary">
  Aucun article récent dans Événements ou Nouveautés.
</div>
<% } else { %>
<div
  id="mixedCarousel"
  class="smeg-frame"
  data-bs-ride="carousel"
  data-bs-interval="5000"
  data-bs-pause="false"
  data-bs-keyboard="true"
  data-bs-touch="true"
  data-bs-wrap="true"
>
  <div class="carousel-inner">
    <% carouselItems.forEach((item, idx) => { %>
    <div class="carousel-item <%= idx === 0 ? 'active' : '' %>">
      <div class="carousel-article-card">
        <div class="carousel-text">
          <h1 class="carousel-title"><%= item.titre %></h1>
          <p class="carousel-excerpt"><%= item.extrait %>...</p>
          <p class="carousel-author">Par <%= item.auteur %></p>
          <p class="carousel-link">
            <a href="/article/<%= item.id %>"
              >Lire l'article complet...</a
            >
          </p>
        </div>
        <div class="carousel-image-wrapper">
          <% if (item.image) { %>
            <img
              src="<%= item.image %>"
              alt="<%= item.titre %>"
              class="card-bordered"
            />
            <% } else { %>
            <div class="carousel-placeholder">
              Aucune image
            </div>
            <% } %>
        </div>
      </div>
    </div>
    <% }) %>
  </div>
    
  </div>
  <% } %>
</div>
