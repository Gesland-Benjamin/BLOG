<% if (pagination && pagination.total > 1) { %>
<nav aria-label="Pagination" class="pagination-nav">
  <ul class="pagination pagination-center">

    <!-- Première page -->
    <li class="page-item <%= !pagination.has_previous ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_previous ? baseUrl + '?' + pageParam + '=1' : '#' %>">
        &laquo;
      </a>
    </li>

    <!-- Précédent -->
    <li class="page-item <%= !pagination.has_previous ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_previous ? baseUrl + '?' + pageParam + '=' + (pagination.current - 1) : '#' %>">
        &lsaquo;
      </a>
    </li>

    <!-- Pages -->
    <% pagination.pages.forEach(p => { %>
      <li class="page-item <%= p.isActive ? 'active' : '' %>">
        <a class="page-link"
           href="<%= baseUrl + '?' + pageParam + '=' + p.number %>">
          <%= p.number %>
        </a>
      </li>
    <% }) %>

    <!-- Suivant -->
    <li class="page-item <%= !pagination.has_next ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_next ? baseUrl + '?' + pageParam + '=' + (pagination.current + 1) : '#' %>">
        &rsaquo;
      </a>
    </li>

    <!-- Dernière -->
    <li class="page-item <%= !pagination.has_next ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_next ? baseUrl + '?' + pageParam + '=' + pagination.total : '#' %>">
        &raquo;
      </a>
    </li>

  </ul>

  <div class="pagination-info">
    Affichage <%= pagination.start_item %> à <%= pagination.end_item %>
    sur <%= pagination.total_items %> résultat<%= pagination.total_items > 1 ? 's' : '' %>
  </div>
</nav>
<% } %>