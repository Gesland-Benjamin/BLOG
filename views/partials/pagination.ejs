<% if (pagination && pagination.total > 1) { %>
<%
  const pageKey = typeof pageParam !== 'undefined' && pageParam ? pageParam : 'page';
  const separator = baseUrl && baseUrl.includes('?') ? '&' : '?';
  const buildUrl = (page) => `${baseUrl}${separator}${pageKey}=${page}`;
%>
<nav aria-label="Pagination" class="pagination-nav">
  <ul class="pagination pagination-center">

    <!-- Première page -->
    <li class="page-item <%= !pagination.has_previous ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_previous ? buildUrl(1) : '#' %>">
        &laquo;
      </a>
    </li>

    <!-- Précédent -->
    <li class="page-item <%= !pagination.has_previous ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_previous ? buildUrl(pagination.current - 1) : '#' %>">
        &lsaquo;
      </a>
    </li>

    <!-- Pages -->
    <% pagination.pages.forEach(p => { %>
      <li class="page-item <%= p.isActive ? 'active' : '' %>">
        <a class="page-link"
           href="<%= buildUrl(p.number) %>">
          <%= p.number %>
        </a>
      </li>
    <% }) %>

    <!-- Suivant -->
    <li class="page-item <%= !pagination.has_next ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_next ? buildUrl(pagination.current + 1) : '#' %>">
        &rsaquo;
      </a>
    </li>

    <!-- Dernière -->
    <li class="page-item <%= !pagination.has_next ? 'disabled' : '' %>">
      <a class="page-link"
         href="<%= pagination.has_next ? buildUrl(pagination.total) : '#' %>">
        &raquo;
      </a>
    </li>

  </ul>

  <div class="pagination-info">
    Affichage <%= pagination.start_item %> à <%= pagination.end_item %>
    sur <%= pagination.total_items %> résultat<%= pagination.total_items > 1 ? 's' : '' %>
  </div>
</nav>
<% } %>