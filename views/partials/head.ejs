<head>
    <meta charset="utf-8" />
    <meta name="csrf-token" content="<%= csrfToken %>">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <% const metadata = typeof seo !== 'undefined' ? seo : { title: "Emi’Pulse", description: '', noindex: true }; %>
    <title><%= metadata.title %> | Emi’Pulse</title>
    <meta name="description" content="<%= metadata.description %>">
    <meta name="robots" content="<%= metadata.noindex ? 'noindex, follow' : 'index, follow' %>">
    <% if (metadata.canonical) { %><link rel="canonical" href="<%= metadata.canonical %>"><% } %>
    <meta property="og:title" content="<%= metadata.title %>">
    <meta property="og:description" content="<%= metadata.description %>">
    <meta property="og:type" content="<%= metadata.type || 'website' %>">
    <meta property="og:site_name" content="Emi’Pulse">
    <meta property="og:locale" content="fr_FR">
    <% if (metadata.canonical) { %><meta property="og:url" content="<%= metadata.canonical %>"><% } %>
    <% if (metadata.image) { %>
      <meta property="og:image" content="<%= metadata.image %>">
      <meta name="twitter:image" content="<%= metadata.image %>">
    <% } %>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= metadata.title %>">
    <meta name="twitter:description" content="<%= metadata.description %>">
    <% if (metadata.published) { %><meta property="article:published_time" content="<%= metadata.published %>"><% } %>
    <% if (metadata.modified) { %><meta property="article:modified_time" content="<%= metadata.modified %>"><% } %>
    <% if (typeof googleVerification !== 'undefined' && googleVerification) { %><meta name="google-site-verification" content="<%= googleVerification %>"><% } %>
    <% if (metadata.schema) { %><script type="application/ld+json" nonce="<%= cspNonce %>"><%- jsonLd(metadata.schema) %></script><% } %>
    <% if (typeof breadcrumbData !== 'undefined') { %><script type="application/ld+json" nonce="<%= cspNonce %>"><%- jsonLd(breadcrumbData) %></script><% } %>
    <script src="<%= typeof assetUrl === 'function' ? assetUrl('/js/color-modes.js') : '/js/color-modes.js' %>"></script>
    <meta name="theme-color" content="#F99285" />
    <link
      href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.cdnfonts.com/css/candice"
      rel="stylesheet"
    />
    <link
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
  rel="stylesheet"
/>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />

    <!-- Fichiers CSS - Architecture modulaire (12 fichiers) -->
    <!-- 1. Base: Variables, reset, typographie -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/1-base.css?v=20260925-seo') : '/css/1-base.css?v=20260925-seo' %>" rel="stylesheet" />
    
    <!-- 2. Layout: Grille, flexbox, spacing utilitaires -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/2-layout.css') : '/css/2-layout.css' %>" rel="stylesheet" />
    
    <!-- 3. Composants: Boutons, cartes, formulaires, etc. -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/3-components.css?v=20260925-seo') : '/css/3-components.css?v=20260925-seo' %>" rel="stylesheet" />
    
    <!-- 4-5. Header & Footer -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/4-header.css?v=20260917-menu-layers') : '/css/4-header.css?v=20260917-menu-layers' %>" rel="stylesheet" />
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/5-footer.css?v=20260925-newsletter') : '/css/5-footer.css?v=20260925-newsletter' %>" rel="stylesheet" />
    
    <!-- 6. Carousel -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/6-carousel.css?v=20260917-menu-layers') : '/css/6-carousel.css?v=20260917-menu-layers' %>" rel="stylesheet" />
    
    <!-- 7-12. Pages spécifiques -->
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/7-pages-home.css?v=20260925-seo') : '/css/7-pages-home.css?v=20260925-seo' %>" rel="stylesheet" />
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/8-pages-article.css?v=20260925-breadcrumb') : '/css/8-pages-article.css?v=20260925-breadcrumb' %>" rel="stylesheet" />
    <% if (typeof pagePath === 'undefined' || pagePath.startsWith('/admin')) { %>
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/9-pages-admin.css') : '/css/9-pages-admin.css' %>" rel="stylesheet" />
    <% } %>
    <% if (typeof pagePath === 'undefined' || /^\/(auth|register|forgot-password|reset-password)(\/|$)/.test(pagePath)) { %>
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/10-pages-auth.css') : '/css/10-pages-auth.css' %>" rel="stylesheet" />
    <% } %>
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/11-pages-error.css') : '/css/11-pages-error.css' %>" rel="stylesheet" />
    <link href="<%= typeof assetUrl === 'function' ? assetUrl('/css/12-pages-other.css?v=20260925-newsletter') : '/css/12-pages-other.css?v=20260925-newsletter' %>" rel="stylesheet" />
    
    <style>
    </style>
  </head>
