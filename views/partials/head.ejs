<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Meta dynamiques pour SEO -->
    <% if (typeof article !== 'undefined' && article && article.titre) { %>
      <title><%= article.titre %> | Blog</title>
      <meta name="description" content="<%= article.description || article.titre %>" />
      <meta name="robots" content="index, follow" />
      <meta property="og:type" content="article" />
      <meta property="og:title" content="<%= article.titre %>" />
      <meta property="og:description" content="<%= article.description || article.titre %>" />
      <meta property="og:url" content="<%= article.url %>" />
      <% if (ogImageTags) { %>
        <%- ogImageTags %>
      <% } %>
      <% if (article.date_publication) { %>
        <% if (article.date_publication_iso) { %>
          <meta name="article:published_time" content="<%= article.date_publication_iso %>" />
        <% } %>
      <% } %>
      <% if (article.auteur) { %>
        <meta name="article:author" content="<%= article.auteur %>" />
      <% } %>
      <% if (article.categorie) { %>
        <meta name="article:section" content="<%= article.categorie %>" />
      <% } %>
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="<%= article.titre %>" />
      <meta name="twitter:description" content="<%= article.description || article.titre %>" />
    <% } else { %>
      <% const pageTitle = (typeof title !== 'undefined' && title) ? `${title} | Blog` : 'Blog | Accueil'; %>
      <meta name="description" content="<%= (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : 'Blog - Découvrez nos articles sur la beauté, la nutrition et le développement personnel' %>" />
      <title><%= pageTitle %></title>
    <% } %>
    
    <meta
      name="author"
      content="Gesland Benjamin"
    />
    <meta name="generator" content="Express.js" />
    <link
      rel="canonical"
      href="<%= (typeof article !== 'undefined' && article) ? article.url : 'http://localhost:3000' %>"
    />
    <script src="/js/color-modes.js"></script>
    <meta name="theme-color" content="#F99285" />
    <link
      href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.cdnfonts.com/css/candice"
      rel="stylesheet"
    />
    <link
  href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css"
  rel="stylesheet"
/>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />

    <!-- Fichiers CSS - Architecture modulaire (12 fichiers) -->
    <!-- 1. Base: Variables, reset, typographie -->
    <link href="/css/1-base.css" rel="stylesheet" />
    
    <!-- 2. Layout: Grille, flexbox, spacing utilitaires -->
    <link href="/css/2-layout.css" rel="stylesheet" />
    
    <!-- 3. Composants: Boutons, cartes, formulaires, etc. -->
    <link href="/css/3-components.css" rel="stylesheet" />
    
    <!-- 4-5. Header & Footer -->
    <link href="/css/4-header.css" rel="stylesheet" />
    <link href="/css/5-footer.css" rel="stylesheet" />
    
    <!-- 6. Carousel -->
    <link href="/css/6-carousel.css" rel="stylesheet" />
    
    <!-- 7-12. Pages spécifiques -->
    <link href="/css/7-pages-home.css" rel="stylesheet" />
    <link href="/css/8-pages-article.css" rel="stylesheet" />
    <link href="/css/9-pages-admin.css" rel="stylesheet" />
    <link href="/css/10-pages-auth.css" rel="stylesheet" />
    <link href="/css/11-pages-error.css" rel="stylesheet" />
    <link href="/css/12-pages-other.css" rel="stylesheet" />
    
    <style>
    </style>
  </head>