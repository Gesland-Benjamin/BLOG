<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Meta dynamiques pour SEO -->
    <% if (article) { %>
      <title><%= article.titre %> | Blog</title>
      <meta name="description" content="<%= article.description || article.titre %>" />
      <meta name="robots" content="index, follow" />
      <meta property="og:type" content="article" />
      <meta property="og:title" content="<%= article.titre %>" />
      <meta property="og:description" content="<%= article.description || article.titre %>" />
      <meta property="og:url" content="<%= article.url %>" />
      <% if (ogImageTags) { %>
        <%- ogImageTags %>
      <% } %>
      <meta name="article:published_time" content="<%= new Date(article.date_publication).toISOString() %>" />
      <meta name="article:author" content="<%= article.auteur %>" />
      <% if (article.categorie) { %>
        <meta name="article:section" content="<%= article.categorie %>" />
      <% } %>
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="<%= article.titre %>" />
      <meta name="twitter:description" content="<%= article.description || article.titre %>" />
    <% } else { %>
      <meta name="description" content="Blog - Découvrez nos articles sur la beauté, la nutrition et le développement personnel" />
      <title>Blog | Accueil</title>
    <% } %>
    
    <meta
      name="author"
      content="Gesland Benjamin"
    />
    <meta name="generator" content="Express.js" />
    <link
      rel="canonical"
      href="<%= article ? article.url : 'http://localhost:3000' %>"
    />
    <script src="/js/color-modes.js"></script>
    <link href="/css/bootstrap.min.css" rel="stylesheet" />
    <meta name="theme-color" content="#F99285" />
    <link
      href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900&display=swap"
      rel="stylesheet"
    />
    <link href="/css/blog.css" rel="stylesheet" />
    <style>
    </style>
  </head>