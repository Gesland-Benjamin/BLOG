<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    
    <!-- Meta dynamiques pour SEO -->
    <% if (typeof article !== 'undefined' && article && article.titre) { %>
      <title><%= article.titre %> | Blog</title>
      <meta name="description" content="<%= article.description || article.titre %>" />
      <meta name="robots" content="index, follow" />
      <meta property="og:type" content="article" />
      <meta property="og:title" content="<%= article.titre %>" />
      <meta property="og:description" content="<%= article.description || article.titre %>" />
      <meta property="og:url" content="<%= article.url %>" />
      <% if (ogImageTags) { %>
        <%- ogImageTags %>
      <% } %>
      <% if (article.date_publication) { %>
        <meta name="article:published_time" content="<%= new Date(article.date_publication).toISOString() %>" />
      <% } %>
      <% if (article.auteur) { %>
        <meta name="article:author" content="<%= article.auteur %>" />
      <% } %>
      <% if (article.categorie) { %>
        <meta name="article:section" content="<%= article.categorie %>" />
      <% } %>
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content="<%= article.titre %>" />
      <meta name="twitter:description" content="<%= article.description || article.titre %>" />
    <% } else { %>
      <% const pageTitle = (typeof title !== 'undefined' && title) ? `${title} | Blog` : 'Blog | Accueil'; %>
      <meta name="description" content="<%= (typeof pageDescription !== 'undefined' && pageDescription) ? pageDescription : 'Blog - Découvrez nos articles sur la beauté, la nutrition et le développement personnel' %>" />
      <title><%= pageTitle %></title>
    <% } %>
    
    <meta
      name="author"
      content="Gesland Benjamin"
    />
    <meta name="generator" content="Express.js" />
    <link
      rel="canonical"
      href="<%= (typeof article !== 'undefined' && article) ? article.url : 'http://localhost:3000' %>"
    />
    <script src="/js/color-modes.js"></script>
    <meta name="theme-color" content="#F99285" />
    <link
      href="https://fonts.googleapis.com/css?family=Playfair+Display:700,900&display=swap"
      rel="stylesheet"
    />
    <!-- Fichiers CSS (ordre important) -->
    <link href="/css/general.css" rel="stylesheet" />
    <link href="/css/animations.css" rel="stylesheet" />
    <link href="/css/header.css" rel="stylesheet" />
    <link href="/css/footer.css" rel="stylesheet" />
    <link href="/css/index.css" rel="stylesheet" />
    <link href="/css/article-detail.css" rel="stylesheet" />
    <link href="/css/auth.css" rel="stylesheet" />
    <link href="/css/admin.css" rel="stylesheet" />
    <link href="/css/pages.css" rel="stylesheet" />
    <style>
    </style>
  </head>