<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="error-wrapper">
      <div class="error-container">
        <div class="error-content">
          <h1 class="error-code code-500">500</h1>
          <h2 class="error-title">Erreur du serveur</h2>
          <p class="error-description">
            Une erreur inattendue s'est produite. Nos équipes ont été notifiées et travaillent à résoudre le problème.
          </p>
          <% if (typeof error !== 'undefined' && error && process.env.NODE_ENV === 'development') { %>
            <div class="error-details">
              <h4>Détails de l'erreur (mode développement) :</h4>
              <pre><%= error %></pre>
            </div>
          <% } %>
          <div class="error-actions">
            <a href="/" class="error-btn primary">Retour à l'accueil</a>
            <button onclick="location.reload()" class="error-btn secondary">Réessayer</button>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
