<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body class="bo">
    <div class="container">
      <%- include('partials/header', { includeNavbar: true }) %>
    </div>

    <main class="container py-5">
      <div class="row g-4">
        <!-- Articles du mois -->
        <div class="col-lg-8">
          <article>
            <h1 class="display-5 mb-4"><%= monthName %> <%= year %></h1>
            
            <% if (articles && articles.length > 0) { %>
              <div class="row g-4">
                <% articles.forEach(article => { %>
                  <div class="col-12">
                    <div class="card shadow-sm card-article">
                      <div class="row g-0 align-items-stretch">
                        <% if (article.image) { %>
                          <div class="col-md-4">
                            <img 
                              src="<%= article.image %>" 
                              alt="<%= article.titre %>" 
                              class="img-fluid h-100"
                              style="object-fit: cover; border-radius: 4px 0 0 4px;"
                            />
                          </div>
                        <% } %>
                        <div class="col-md-<%= article.image ? 8 : 12 %>">
                          <div class="card-body">
                            <h2 class="card-title h5">
                              <a href="/article/<%= article.id %>" class="text-decoration-none">
                                <%= article.titre %>
                              </a>
                            </h2>
                            
                            <p class="card-text text-muted small mb-2">
                              <strong><%= article.categorie || 'Non catégorisé' %></strong> | 
                              <%= new Date(article.date_publication).toLocaleDateString('fr-FR', { 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric' 
                              }) %>
                            </p>
                            
                            <p class="card-text"><%= article.extrait %>...</p>
                            
                            <a href="/article/<%= article.id %>" class="btn btn-sm btn-primary">
                              Lire la suite →
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% }) %>
              </div>
            <% } else { %>
              <div class="alert alert-info">
                Aucun article publié en <%= monthName %> <%= year %>.
              </div>
            <% } %>
          </article>
        </div>

        <!-- Sidebar -->
        <div class="col-lg-4">
          <!-- Recent Posts -->
          <article class="card-smeg smeg-frame">
            <div class="p-4">
              <h4 class="fst-italic mb-3">Articles récents</h4>
              <ul class="list-unstyled">
                <% if (recentPosts && recentPosts.length > 0) { %>
                  <% recentPosts.forEach(post => { %>
                    <li class="border-top py-3 text-body-secondary">
                      <a href="/article/<%= post.id %>" class="text-decoration-none text-body-emphasis fw-bold">
                        <%= post.titre %>
                      </a>
                      <div class="small text-muted">
                        <%= new Date(post.date_publication).toLocaleDateString('fr-FR') %>
                      </div>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="border-top py-3 text-body-secondary">Aucun article récent.</li>
                <% } %>
              </ul>
            </div>
          </article>

          <!-- Archives -->
          <article class="card-smeg smeg-frame">
            <div class="p-4">
              <h4 class="fst-italic mb-3">Archives</h4>
              <ol class="list-unstyled mb-0">
                <li><a href="/archive/2025/12">Décembre 2025</a></li>
                <li><a href="/archive/2025/11">Novembre 2025</a></li>
                <li><a href="/archive/2025/10">Octobre 2025</a></li>
                <li><a href="/archive/2025/9">Septembre 2025</a></li>
                <li><a href="/archive/2025/8">Août 2025</a></li>
                <li><a href="/archive/2025/7">Juillet 2025</a></li>
                <li><a href="/archive/2025/6">Juin 2025</a></li>
                <li><a href="/archive/2025/5">Mai 2025</a></li>
                <li><a href="/archive/2025/4">Avril 2025</a></li>
                <li><a href="/archive/2025/3">Mars 2025</a></li>
                <li><a href="/archive/2025/2">Février 2025</a></li>
                <li><a href="/archive/2025/1">Janvier 2025</a></li>
              </ol>
            </div>
          </article>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
