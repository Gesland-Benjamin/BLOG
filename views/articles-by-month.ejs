<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body class="bo">
    <%- include('partials/header', { includeNavbar: true }) %>

    <main class="content-wrapper archive-layout">
      <div class="content-container">
        <!-- Articles du mois -->
        <div class="archive-main-content">
          <article>
            <h1 class="archive-title"><%= monthName %> <%= year %></h1>
            
            <% if (articles && articles.length > 0) { %>
              <div class="archive-articles">
                <% articles.forEach(article => { %>
                  <article class="archive-article-card">
                    <div class="archive-article-layout">
                      <% if (article.image) { %>
                        <div class="archive-article-image">
                          <img 
                            src="<%= article.image %>" 
                            alt="<%= article.titre %>"
                          />
                        </div>
                      <% } %>
                      <div class="archive-article-content <%= article.image ? '' : 'full-width' %>">
                        <h2 class="archive-article-title">
                          <a href="/article/<%= article.id %>">
                            <%= article.titre %>
                          </a>
                        </h2>
                        
                        <p class="archive-article-meta">
                          <strong><%= article.categorie || 'Non catégorisé' %></strong> | 
                          <%= article.date_publication_formatted || '' %>
                        </p>
                        
                        <p class="archive-article-excerpt"><%= article.extrait %>...</p>
                        
                        <a href="/article/<%= article.id %>" class="archive-article-btn">
                          Lire la suite →
                        </a>
                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="archive-no-articles">
                Aucun article publié en <%= monthName %> <%= year %>.
              </div>
            <% } %>
          </article>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
