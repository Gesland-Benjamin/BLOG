<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body class="bo">
    <%- include('partials/header', { includeNavbar: true }) %>

    <main class="content-wrapper archive-layout">
      <div class="content-container">
        <!-- Articles du mois -->
        <div class="archive-main-content">
          <article>
            <h1 class="archive-title"><%= monthName %> <%= year %></h1>
            
            <% if (articles && articles.length > 0) { %>
              <div class="archive-articles">
                <% articles.forEach(article => { %>
                  <article class="archive-article-card">
                    <div class="archive-article-layout">
                      <% if (article.image) { %>
                        <div class="archive-article-image">
                          <img 
                            src="<%= article.image %>" 
                            alt="<%= article.titre %>"
                          />
                        </div>
                      <% } %>
                      <div class="archive-article-content <%= article.image ? '' : 'full-width' %>">
                        <h2 class="archive-article-title">
                          <a href="/article/<%= article.id %>">
                            <%= article.titre %>
                          </a>
                        </h2>
                        
                        <p class="archive-article-meta">
                          <strong><%= article.categorie || 'Non catégorisé' %></strong> | 
                          <%= new Date(article.date_publication).toLocaleDateString('fr-FR', { 
                            year: 'numeric', 
                            month: 'long', 
                            day: 'numeric' 
                          }) %>
                        </p>
                        
                        <p class="archive-article-excerpt"><%= article.extrait %>...</p>
                        
                        <a href="/article/<%= article.id %>" class="archive-article-btn">
                          Lire la suite →
                        </a>
                      </div>
                    </div>
                  </article>
                <% }) %>
              </div>
            <% } else { %>
              <div class="archive-no-articles">
                Aucun article publié en <%= monthName %> <%= year %>.
              </div>
            <% } %>
          </article>
        </div>

        <!-- Sidebar -->
        <aside class="archive-sidebar">
          <!-- Recent Posts -->
          <article class="card-smeg smeg-frame">
            <div class="sidebar-section">
              <h4 class="sidebar-title">Articles récents</h4>
              <ul class="sidebar-list">
                <% if (recentPosts && recentPosts.length > 0) { %>
                  <% recentPosts.forEach(post => { %>
                    <li class="sidebar-list-item">
                      <a href="/article/<%= post.id %>" class="sidebar-link">
                        <%= post.titre %>
                      </a>
                      <div class="sidebar-date">
                        <%= new Date(post.date_publication).toLocaleDateString('fr-FR') %>
                      </div>
                    </li>
                  <% }) %>
                <% } else { %>
                  <li class="sidebar-list-item">Aucun article récent.</li>
                <% } %>
              </ul>
            </div>
          </article>

          <!-- Archives -->
          <article class="card-smeg smeg-frame">
            <div class="sidebar-section">
              <h4 class="sidebar-title">Archives</h4>
              <ol class="sidebar-list">
                <li><a href="/archive/2025/12">Décembre 2025</a></li>
                <li><a href="/archive/2025/11">Novembre 2025</a></li>
                <li><a href="/archive/2025/10">Octobre 2025</a></li>
                <li><a href="/archive/2025/9">Septembre 2025</a></li>
                <li><a href="/archive/2025/8">Août 2025</a></li>
                <li><a href="/archive/2025/7">Juillet 2025</a></li>
                <li><a href="/archive/2025/6">Juin 2025</a></li>
                <li><a href="/archive/2025/5">Mai 2025</a></li>
                <li><a href="/archive/2025/4">Avril 2025</a></li>
                <li><a href="/archive/2025/3">Mars 2025</a></li>
                <li><a href="/archive/2025/2">Février 2025</a></li>
                <li><a href="/archive/2025/1">Janvier 2025</a></li>
              </ol>
            </div>
          </article>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
