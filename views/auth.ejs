<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  
  <body>
   <%- include('partials/header') %>
    <main class="auth-wrapper">
      <div class="auth-container">
        <div class="auth-form-card">
          <h2>Connexion</h2>
          
          <% if (errors && errors.length > 0) { %>
            <div class="auth-alert error">
              <ul>
                <% errors.forEach(error => { %>
                  <li><%= error %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>
          
          <form method="POST" action="/auth" class="auth-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="auth-form-group">
              <label for="email">Adresse email</label>
              <input type="email" id="email" name="email" value="<%= formData.email || '' %>" required autocomplete="username">
            </div>
            <div class="auth-form-group">
              <label for="mot_de_passe">Mot de passe</label>
              <input type="password" id="mot_de_passe" name="mot_de_passe" required autocomplete="current-password">
            </div>
            <button type="submit" class="auth-submit-btn">Se connecter</button>
          </form> 
          <div class="auth-footer">
            <a href="/auth/forgot">Mot de passe oublié ?</a>
          </div>
          <div class="auth-footer">
            <a href="/auth/register">Créer un compte</a>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>