<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>

    <main class="admin-wrapper article-compose">
      <div class="admin-container-narrow">
        <div class="admin-form-card">

          <div class="article-compose-heading">
            <span class="article-compose-eyebrow">Espace rédaction</span>
            <h1><%= isEditing ? 'Modifier l\'article' : 'Nouvel article' %></h1>
            <p><%= isEditing ? 'Peaufinez votre texte et les images qui l’accompagnent.' : 'Une idée, une histoire, un conseil… À vous de partager.' %></p>
          </div>

          <% if (errors && errors.length > 0) { %>
            <div class="admin-alert error" role="alert">
              <ul>
                <% errors.forEach(error => { %>
                  <li><%= error %></li>
                <% }) %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer le message"></button>
            </div>
          <% } %>

          <form method="POST"
                action="<%= isEditing ? `/admin/articles/${article.id}?_method=PUT` : '/admin/articles' %>"
                enctype="multipart/form-data"
                class="admin-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <section class="article-compose-section" aria-labelledby="article-basics">
              <div class="article-compose-section-heading">
                <h2 id="article-basics">L’essentiel</h2>
                <p>Donnez un titre à votre article et choisissez sa catégorie.</p>
              </div>
              <div class="article-compose-grid">
            <!-- TITLE -->
            <div class="admin-form-group">
              <label for="title">Titre</label>
              <input
                type="text"
                id="title"
                name="title"
                value="<%= isEditing ? article.title : (formData.title || '') %>"
                required>
              <small class="admin-form-hint">Au moins 5 caractères pour présenter votre sujet.</small>
            </div>

            <!-- CATEGORY -->
            <div class="admin-form-group">
              <label for="categorieId">Catégorie</label>
              <select id="categorieId" name="categorieId" required>
                <option value="">-- Choisir une catégorie --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"
                    <%= isEditing && cat.id === article.categorieId ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

              </div>
            </section>

            <section class="article-compose-section" aria-labelledby="article-writing">
              <div class="article-compose-section-heading">
                <h2 id="article-writing">Votre texte</h2>
                <p>Prenez le temps de raconter. La mise en forme est à portée de main.</p>
              </div>
            <!-- CONTENT -->
            <div class="admin-form-group">
              <label for="content">Contenu</label>
              <div class="article-format-toolbar" role="group" aria-label="Mise en forme du texte" hidden>
                <button type="button" data-format="**" aria-controls="content" title="Gras (Ctrl ou Cmd + B)"><strong>Gras</strong></button>
                <button type="button" data-format="_" aria-controls="content" title="Italique (Ctrl ou Cmd + I)"><em>Italique</em></button>
              </div>
              <div class="admin-form-group"><label for="internal-article">Insérer un lien vers un article</label><select id="internal-article"><option value="">Choisir un article publié</option><% linkArticles.forEach(item => { %><option value="<%= articlePath(item) %>"><%= item.title %></option><% }) %></select><button type="button" id="insert-article-link">Insérer le lien</button></div>
              <textarea
                id="content"
                name="content"
                rows="12"
                aria-describedby="content-help"
                required><%= isEditing ? article.content : (formData.content || '') %></textarea>
              <small class="admin-form-hint" id="content-help">
                Sélectionnez un passage puis cliquez sur Gras ou Italique. Vous pouvez combiner les deux.
                Les marqueurs <code>**gras**</code> et <code>_italique_</code> seront remplacés à la publication.
                Une ligne commençant par <code>## </code> crée une section H2 ; <code>### </code> crée une sous-section H3. Deux H2 déclenchent le sommaire.
                Min 50 caractères. Pour placer l'image inline dans le texte,
                insérez le marqueur <code>[[IMAGE_INLINE]]</code> à l'endroit souhaité.
              </small>
              <details class="article-editor-preview" hidden>
                <summary>Aperçu de la mise en forme</summary>
                <div id="article-content-preview"></div>
              </details>
            </div>

            </section>

            <section class="article-compose-section" aria-labelledby="article-media">
              <div class="article-compose-section-heading">
                <h2 id="article-media">Images & vidéo</h2>
                <p>Ajoutez une touche visuelle à votre histoire. Ces éléments sont facultatifs.</p>
              </div>
              <div class="article-compose-grid">
            <!-- IMAGE -->
            <div class="admin-form-group">
              <label for="image">Image principale</label>
              <input type="file" id="image" name="image" accept="image/*">

              <small class="admin-form-hint">
                Formats acceptés: JPEG, PNG, GIF, WebP (Max 5 MB)<br>
                L'image sera automatiquement optimisée
              </small>

              <% if (isEditing && article.image) { %>
                <div class="admin-image-preview">
                  <small>Image actuelle :</small>
                  <img src="<%= article.image %>" alt="<%= article.title %>">
                </div>
              <% } %>
            </div>

            <!-- IMAGE INLINE (OPTIONNEL) -->
            <div class="admin-form-group">
              <label for="image_inline">Image dans l’article <span class="article-compose-optional">Facultatif</span></label>
              <input type="file" id="image_inline" name="image_inline" accept="image/*">

              <small class="admin-form-hint">
                Cette image s'affichera à l'endroit du marqueur <code>[[IMAGE_INLINE]]</code>
                dans le contenu. Si le marqueur n'est pas présent, elle s'affichera
                automatiquement sous le texte.
              </small>

              <% if (isEditing && article.image_inline) { %>
                <div class="admin-image-preview">
                  <small>Image secondaire actuelle :</small>
                  <img src="<%= article.image_inline %>" alt="<%= article.title %>">
                </div>
              <% } %>
            </div>

              </div>
              <div class="article-compose-grid">
            <!-- IMAGE ALT -->
            <div class="admin-form-group">
              <label for="image_alt">Description de l’image</label>
              <input
                type="text"
                id="image_alt"
                name="image_alt"
                value="<%= isEditing ? (article.image_alt || '') : (formData.image_alt || '') %>"
                placeholder="Ex: Photo beauté visage naturel">

              <small class="admin-form-hint">
                Décrivez ce que montre l’image pour les lecteurs et l’accessibilité.
              </small>
            </div>

            <!-- VIDEO -->
            <div class="admin-form-group">
              <label for="video">Vidéo <span class="article-compose-optional">Facultatif</span></label>
              <input
                type="url"
                id="video"
                name="video"
                placeholder="YouTube ou Vimeo — coller l'URL complète"
                value="<%= isEditing ? (article.video || '') : (formData.video || '') %>">
              <small class="admin-form-hint">L'URL sera automatiquement convertie en format embed (YouTube/Vimeo).</small>
            </div>

              </div>
            </section>

            <section class="article-compose-section" aria-labelledby="seo-options">
              <h2 id="seo-options">Référencement et publication</h2>
              <div class="admin-form-group"><label for="seo_title">Titre SEO (facultatif)</label><input id="seo_title" name="seo_title" maxlength="255" value="<%= article.seo_title || formData.seo_title || '' %>"><small>Par défaut, le titre de l’article sera utilisé.</small></div>
              <div class="admin-form-group"><label for="meta_description">Meta description (facultative)</label><textarea id="meta_description" name="meta_description" maxlength="320"><%= article.meta_description || formData.meta_description || '' %></textarea><small>Visez une description concise et fidèle au contenu. Sans saisie, un extrait sera utilisé.</small></div>
              <div class="admin-form-group"><label for="image_alt">Description de l’image</label><input id="image_alt" name="image_alt" maxlength="255" value="<%= article.image_alt || formData.image_alt || '' %>"></div>
              <div class="admin-form-group"><label for="is_published">Visibilité</label><select id="is_published" name="is_published"><option value="true" <%= article.is_published !== false ? 'selected' : '' %>>Publié</option><option value="false" <%= article.is_published === false ? 'selected' : '' %>>Brouillon (privé)</option></select></div>
              <div class="admin-form-group"><label for="related_article_ids">Articles liés (5 maximum)</label><select id="related_article_ids" name="related_article_ids" multiple size="5"><% linkArticles.filter(item => item.id !== article.id).forEach(item => { %><option value="<%= item.id %>" <%= (article.related_article_ids || []).includes(item.id) ? 'selected' : '' %>><%= item.title %></option><% }) %></select></div>
              <% if (article.slug) { %><p>URL conservée : <code><%= articlePath(article) %></code></p><% } %>
            </section>
            <!-- ACTIONS -->
            <div class="admin-form-actions">
              <button type="submit" class="admin-btn primary">
                <%= isEditing ? 'Enregistrer les modifications' : 'Créer l’article' %>
              </button>

              <a href="/article" class="btn-smeg secondary">
                Annuler
              </a>
            </div>

          </form>

        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script type="module" src="/js/article-editor.js?v=20260925-seo"></script>
  </body>
</html>
