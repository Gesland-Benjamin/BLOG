<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>

    <main class="admin-wrapper">
      <div class="admin-container-narrow">
        <div class="admin-form-card">

          <h2><%= isEditing ? 'Modifier l\'article' : 'Nouvel article' %></h2>

          <% if (errors && errors.length > 0) { %>
            <div class="admin-alert error" role="alert">
              <ul>
                <% errors.forEach(error => { %>
                  <li><%= error %></li>
                <% }) %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <form method="POST"
                action="<%= isEditing ? `/admin/articles/${article.id}?_method=PUT` : '/admin/articles' %>"
                enctype="multipart/form-data"
                class="admin-form">

            <!-- TITLE -->
            <div class="admin-form-group">
              <label for="title">Titre</label>
              <input
                type="text"
                id="title"
                name="title"
                value="<%= isEditing ? article.title : (formData.title || '') %>"
                required>
              <small class="admin-form-hint">Min 5 caractères</small>
            </div>

            <!-- CONTENT -->
            <div class="admin-form-group">
              <label for="content">Contenu</label>
              <textarea
                id="content"
                name="content"
                rows="6"
                required><%= isEditing ? article.content : (formData.content || '') %></textarea>
              <small class="admin-form-hint">Min 50 caractères</small>
            </div>

            <!-- CATEGORY -->
            <div class="admin-form-group">
              <label for="categorieId">Catégorie</label>
              <select id="categorieId" name="categorieId" required>
                <option value="">-- Choisir une catégorie --</option>
                <% categories.forEach(cat => { %>
                  <option value="<%= cat.id %>"
                    <%= isEditing && cat.id === article.categorieId ? 'selected' : '' %>>
                    <%= cat.name %>
                  </option>
                <% }) %>
              </select>
            </div>

            <!-- IMAGE -->
            <div class="admin-form-group">
              <label for="image">Ajouter une image</label>
              <input type="file" id="image" name="image" accept="image/*">

              <small class="admin-form-hint">
                Formats acceptés: JPEG, PNG, GIF, WebP (Max 5 MB)<br>
                L'image sera automatiquement optimisée
              </small>

              <% if (isEditing && article.image) { %>
                <div class="admin-image-preview">
                  <small>Image actuelle :</small>
                  <img src="<%= article.image %>" alt="<%= article.title %>">
                </div>
              <% } %>
            </div>

            <!-- IMAGE ALT -->
            <div class="admin-form-group">
              <label for="image_alt">Description image (SEO)</label>
              <input
                type="text"
                id="image_alt"
                name="image_alt"
                value="<%= isEditing ? (article.image_alt || '') : (formData.image_alt || '') %>"
                placeholder="Ex: Photo beauté visage naturel">

              <small class="admin-form-hint">
                Important pour SEO et accessibilité
              </small>
            </div>

            <!-- VIDEO -->
            <div class="admin-form-group">
              <label for="video">URL vidéo (optionnel)</label>
              <input
                type="url"
                id="video"
                name="video"
                placeholder="YouTube ou Vimeo — coller l'URL complète"
                value="<%= isEditing ? (article.video || '') : (formData.video || '') %>">
              <small class="admin-form-hint">L'URL sera automatiquement convertie en format embed (YouTube/Vimeo).</small>
            </div>

            <!-- ACTIONS -->
            <div class="admin-form-actions">
              <button type="submit" class="admin-btn primary">
                <%= isEditing ? 'Mettre à jour' : 'Créer' %>
              </button>

              <a href="/article" class="btn-smeg secondary">
                Annuler
              </a>
            </div>

          </form>

        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>