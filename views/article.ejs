<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="content-container">
        <% if (typeof article !== 'undefined' && article) { %>
          <!-- Affichage d'un article individuel -->
          <div class="article-card">
            <% if (article.image) { %>
              <img src="<%= article.image %>" alt="<%= article.image_alt || article.titre %>" class="article-image">
            <% } %>
            <h1 class="page-title"><%= article.titre %></h1>
            <div class="article-meta">
              Par <%= article.auteur %> · <%= article.date_publication.toLocaleDateString() %>
            </div>
            <div class="article-content">
              <%- article.contenuHtml %>
            </div>
            <div class="article-actions">
              <a href="/article" class="btn-general">Tous les articles</a>
            </div>
          </div>
          <% if (commentaires && commentaires.length > 0) { %>
            <section class="comments-section">
              <h2 class="page-title" style="font-size:1.3rem; margin-top:2.5rem;">Commentaires</h2>
              <% commentaires.forEach(function(commentaire) { %>
                <div class="comment-card">
                  <div class="comment-author"><%= commentaire.auteur %></div>
                  <div class="comment-date"><%= commentaire.date_publication.toLocaleDateString() %></div>
                  <div class="comment-content"><%= commentaire.contenu %></div>
                  <div class="comment-actions"></div>
                </div>
              <% }) %>
            </section>
          <% } %>
        <% } else if (typeof articlesParCategorie !== 'undefined' && Array.isArray(articlesParCategorie) && articlesParCategorie.length > 0) { %>
          <!-- Affichage de la liste des articles par catégorie -->
          <h1 class="page-title">Derniers articles par catégorie</h1>
          <div class="archive-articles">
            <% articlesParCategorie.forEach(function(item) { %>
              <article class="archive-article-card">
                <div class="archive-article-layout">
                  <% if (item.image) { %>
                    <div class="archive-article-image">
                      <img src="<%= item.image %>" alt="<%= item.image_alt || item.titre %>" loading="lazy">
                    </div>
                  <% } %>
                  <div class="archive-article-content <%= item.image ? '' : 'full-width' %>">
                    <h2 class="archive-article-title">
                      <a href="/article/<%= item.id %>"><%= item.titre %></a>
                    </h2>
                    <p class="archive-article-meta">
                      <% if (item.categorie) { %><strong><%= item.categorie %></strong> | <% } %>
                      <%= new Date(item.date_publication).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                    </p>
                    <p class="archive-article-excerpt"><%= (item.contenu || '').substring(0, 200) %>...</p>
                    <a href="/article/<%= item.id %>" class="archive-article-btn">Lire la suite →</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-articles-message">Aucun article à afficher.</p>
        <% } %>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>