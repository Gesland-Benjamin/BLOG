
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="content-container">
        <h1 class="page-title-center">Derniers articles par catégorie</h1>
        <div class="article-grid">
          <% if (articlesParCategorie && articlesParCategorie.length > 0) { %>
            <% articlesParCategorie.forEach(function(item) { %>
              <article class="article-card">
                <% if (item.image) { %>
                  <div class="article-card-image">
                    <img 
                      src="<%= item.image %>" 
                      alt="<%= item.image_alt || item.titre %>"
                      loading="lazy"
                    >
                  </div>
                <% } %>
                <div class="article-card-content">
                  <h3 class="article-card-category"><%= item.categorie %></h3>
                  <h5 class="article-card-title"><%= item.titre %></h5>
                  <p class="article-card-excerpt"><%= item.contenu.substring(0, 120) %>...</p>
                  <div class="article-card-meta">
                    Par <%= item.auteur %>,
                    le <%= item.date_publication.toLocaleDateString() %>
                  </div>
                  <a href="/article/<%= item.id %>" class="article-card-btn">Lire l'article</a>
                </div>
              </article>
            <% }) %>
          <% } else { %>
            <p class="no-articles-message">Aucun article disponible pour le moment.</p>
          <% } %>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>