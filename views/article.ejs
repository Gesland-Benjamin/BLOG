<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="content-container">
        <% if (typeof article !== 'undefined' && article) { %>
          <!-- Affichage d'un article individuel -->
          <div class="article-card">
            <% if (article.image) { %>
              <img src="<%= article.image %>" alt="<%= article.image_alt || article.titre %>" class="article-image">
            <% } %>
            <h1 class="page-title"><%= article.titre %></h1>
            <div class="article-meta">
              Par <%= article.auteur %> · <%= article.date_publication.toLocaleDateString() %>
            </div>
            <div class="article-content">
              <%- article.contenuHtml %>
            </div>
            <div class="article-actions">
              <a href="/article" class="btn-smeg">Tous les articles</a>
            </div>
          </div>
          <% if (commentaires && commentaires.length > 0) { %>
            <section class="comments-section">
              <h2 class="page-title" style="font-size:1.3rem; margin-top:2.5rem;">Commentaires</h2>
              <% commentaires.forEach(function(commentaire) { %>
                <div class="comment-card">
                  <div class="comment-author"><%= commentaire.auteur %></div>
                  <div class="comment-date"><%= commentaire.date_publication.toLocaleDateString() %></div>
                  <div class="comment-content"><%= commentaire.contenu %></div>
                  <div class="comment-actions"></div>
                </div>
              <% }) %>
            </section>
          <% } %>
        <% } else if (typeof articlesParCategorie !== 'undefined' && Array.isArray(articlesParCategorie) && articlesParCategorie.length > 0) { %>
          <!-- Affichage de la liste des articles par catégorie -->
          <h1 class="page-title">Derniers articles par catégorie</h1>
          <div class="article-grid">
            <% articlesParCategorie.forEach(function(item) { %>
              <article class="article-card">
                <% if (item.image) { %>
                  <div class="article-card-image">
                    <img 
                      src="<%= item.image %>" 
                      alt="<%= item.image_alt || item.titre %>"
                      loading="lazy"
                    >
                  </div>
                <% } %>
                <div class="article-card-content">
                  <h3 class="article-card-category"><%= item.categorie %></h3>
                  <h5 class="article-card-title"><%= item.titre %></h5>
                  <p class="article-card-excerpt"><%= item.contenu.substring(0, 120) %>...</p>
                  <div class="article-card-meta">
                    Par <%= item.auteur %>,
                    le <%= item.date_publication.toLocaleDateString() %>
                  </div>
                  <a href="/article/<%= item.id %>" class="btn-smeg primary">Lire l'article</a>
                </div>
              </article>
            <% }) %>
          </div>
        <% } else { %>
          <p class="no-articles-message">Aucun article à afficher.</p>
        <% } %>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>