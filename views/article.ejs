
<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="container" style="margin-top:60px;">
      <h1 class="mb-5 text-center">Derniers articles par catégorie</h1>
      <div class="row g-4">
        <% if (articlesParCategorie && articlesParCategorie.length > 0) { %>
          <% articlesParCategorie.forEach(function(item) { %>
            <div class="col-md-4 d-flex mb-4">
              <div class="card shadow-sm">
                <% if (item.image) { %>
                  <div class="card-img-top bg-light" style="height: 200px; overflow: hidden;">
                    <img 
                      src="<%= item.image %>" 
                      alt="<%= item.image_alt || item.titre %>"
                      class="w-100 h-100 object-fit-cover"
                      loading="lazy"
                    >
                  </div>
                <% } %>
                <div class="card-body">
                  <h3 class="card-title"><%= item.categorie %></h3>
                  <h5><%= item.titre %></h5>
                  <p><%= item.contenu.substring(0, 120) %>...</p>
                  <small>
                    Par <%= item.auteur %>,
                    le <%= item.date_publication.toLocaleDateString() %>
                  </small>
                  <br>
                  <a href="/article/<%= item.id %>" class="btn btn-primary btn-sm mt-2">Lire l'article</a>
                </div>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <p class="text-center">Aucun article disponible pour le moment.</p>
        <% } %>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>