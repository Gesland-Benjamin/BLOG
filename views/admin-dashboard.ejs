<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>Dashboard Admin</h1>
          <div class="admin-header-actions">
            <a href="/admin/articles/new" class="admin-btn primary">Nouvel article</a>
            <a href="/" class="admin-btn secondary">Voir le site</a>
          </div>
        </div>

        <!-- Statistiques -->
        <div class="admin-stats-grid">
          <div class="admin-stat-card primary">
            <div class="admin-stat-value"><%= stats.totalArticles %></div>
            <div class="admin-stat-label">Articles publiés</div>
            <a href="/article" class="stretched-link"></a>
          </div>
          <div class="admin-stat-card warning">
            <div class="admin-stat-value"><%= stats.commentairesPending %></div>
            <div class="admin-stat-label">Commentaires en attente</div>
            <a href="/admin/commentaires" class="stretched-link"></a>
          </div>
          <div class="admin-stat-card info">
            <div class="admin-stat-value"><%= stats.totalCommentaires %></div>
            <div class="admin-stat-label">Commentaires total</div>
            <a href="/admin/commentaires" class="stretched-link"></a>
          </div>
          <div class="admin-stat-card success">
            <div class="admin-stat-value"><%= stats.totalAbonnes %></div>
            <div class="admin-stat-label">Abonnés newsletter</div>
            <a href="/admin/newsletter" class="stretched-link"></a>
          </div>
        </div>

        <!-- Accès rapide -->
        <div class="admin-content-grid">
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Articles récents</h5>
              <a href="/admin/articles/new" class="admin-btn-sm primary">Créer</a>
            </div>
            <div class="admin-list">
              <% if (recentArticles.length === 0) { %>
                <div class="admin-list-empty">Aucun article</div>
              <% } else { %>
                <% recentArticles.forEach(a => { %>
                  <div class="admin-list-item">
                    <div class="admin-list-content">
                      <a href="/article/<%= a.id %>" class="admin-list-title"><%= a.titre %></a>
                      <div class="admin-list-meta">
                        <%= new Date(a.date_publication).toLocaleDateString() %> — <%= a.likes || 0 %> j'aime<%= (a.likes || 0) > 1 ? 's' : '' %>
                      </div>
                    </div>
                    <div class="admin-list-actions" style="margin-top:0.7rem;">
                      <a href="/admin/articles/<%= a.id %>/edit" class="admin-btn-sm secondary">Éditer</a>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Commentaires en attente</h5>
              <a href="/admin/commentaires" class="admin-btn-sm warning">Voir tout</a>
            </div>
            <div class="admin-list">
              <% if (pendingComments.length === 0) { %>
                <div class="admin-list-empty">Aucun commentaire en attente</div>
              <% } else { %>
                <% pendingComments.forEach(c => { %>
                  <div class="admin-list-item">
                    <div class="admin-list-content">
                      <div class="admin-comment-author"><%= c.nom || 'Lecteur' %></div>
                      <div class="admin-comment-meta">
                        <% if (c.article) { %>
                          Sur : <a href="/article/<%= c.article.id %>"><%= c.article.titre %></a>
                        <% } else { %>
                          Article supprimé
                        <% } %>
                      </div>
                      <div class="admin-comment-excerpt"><%= c.contenu.substring(0, 80) %><%= c.contenu.length > 80 ? '...' : '' %></div>
                    </div>
                    <div class="admin-list-actions">
                      <form method="POST" action="/admin/commentaires/<%= c.id %>/approve">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="admin-btn-sm success" type="submit">✓</button>
                      </form>
                      <form method="POST" action="/admin/commentaires/<%= c.id %>/reject">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button class="admin-btn-sm danger" type="submit">✕</button>
                      </form>
                    </div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Tableaux supplémentaires -->
        <div class="admin-content-grid">
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Articles les plus aimés</h5>
            </div>
            <div class="admin-list">
              <% if (topArticles.length === 0) { %>
                <div class="admin-list-empty">Aucun article</div>
              <% } else { %>
                <% topArticles.forEach(a => { %>
                  <div class="admin-list-item">
                    <div class="admin-list-content">
                      <a href="/article/<%= a.id %>" class="admin-list-title"><%= a.titre %></a>
                    </div>
                    <span class="admin-badge primary"><%= a.likes || 0 %> j'aime<%= (a.likes || 0) > 1 ? 's' : '' %></span>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>

          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Derniers abonnés newsletter</h5>
              <a href="/admin/newsletter" class="admin-btn-sm success">Gérer</a>
            </div>
            <div class="admin-list">
              <% if (recentSubscribers.length === 0) { %>
                <div class="admin-list-empty">Aucun abonné</div>
              <% } else { %>
                <% recentSubscribers.forEach(s => { %>
                  <div class="admin-list-item">
                    <div class="admin-list-content">
                      <strong><%= s.email %></strong>
                    </div>
                    <div class="admin-list-date"><%= new Date(s.date_inscription).toLocaleDateString() %></div>
                  </div>
                <% }) %>
              <% } %>
            </div>
          </div>
        </div>

      </div>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
