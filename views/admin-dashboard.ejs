<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>

  <body>
    <%- include('partials/header', { withContainer: true }) %>

    <main class="admin-wrapper">
      <div class="admin-container">

        <!-- STATS -->
        <div class="admin-stats-row">

          <div class="admin-stat-card mini info">
            <div class="admin-stat-value"><%= stats.totalUsers %></div>
            <div class="admin-stat-label">Utilisateurs</div>
          </div>

          <div class="admin-stat-card mini primary">
            <div class="admin-stat-value"><%= stats.totalArticles %></div>
            <div class="admin-stat-label">Articles</div>
          </div>

          <div class="admin-stat-card mini warning">
            <div class="admin-stat-value"><%= stats.commentairesPending %></div>
            <div class="admin-stat-label">Commentaires en attente</div>
          </div>

          <div class="admin-stat-card mini info">
            <div class="admin-stat-value"><%= stats.totalCommentaires %></div>
            <div class="admin-stat-label">Commentaires</div>
          </div>

          <div class="admin-stat-card mini success">
            <div class="admin-stat-value"><%= stats.totalAbonnes %></div>
            <div class="admin-stat-label">Abonnés</div>
          </div>

        </div>

        <!-- GRID -->
        <div class="admin-panels-grid">

          <!-- USERS -->
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Liste des utilisateurs</h5>
            </div>

            <div class="admin-list">
              <% if (!users || users.length === 0) { %>
                <div class="admin-list-empty">Aucun utilisateur</div>
              <% } %>

              <% users.forEach(u => { %>
                <div class="admin-list-item">
                  <div class="admin-list-content">
                    <strong><%= u.name %></strong>
                    <div class="admin-list-meta">
                      <%= u.email %> —
                      <span class="admin-badge <%= u.role === 'admin' ? 'primary' : 'info' %>">
                        <%= u.role %>
                      </span>
                    </div>
                  </div>

                  <form method="POST" action="/admin/users/delete/<%= u.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="admin-btn-sm danger">Supprimer</button>
                  </form>
                </div>
              <% }) %>
            </div>

            <%- include('partials/pagination', {
              pagination: usersPagination,
              baseUrl: '/admin/dashboard'
            }) %>
          </div>

          <!-- ARTICLES -->
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Articles récents</h5>
              <a href="/admin/articles/new" class="btn-general">Créer</a>
            </div>

            <div class="admin-list">
              <% if (!recentArticles || recentArticles.length === 0) { %>
                <div class="admin-list-empty">Aucun article</div>
              <% } %>

              <% recentArticles.slice(0, 3).forEach(a => { %>
                <div class="admin-list-item">
                  <div class="admin-list-content">
                    <a href="/article/<%= a.id %>" class="admin-list-title">
                      <%= a.title %>
                    </a>

                    <div class="admin-list-meta">
                      <%= new Date(a.created_at).toLocaleDateString() %>
                      — <%= a.likes || 0 %> like(s)
                    </div>

                    <div class="admin-list-actions">
                      <a href="/admin/articles/<%= a.id %>/edit" class="admin-btn-sm secondary">
                        Éditer
                      </a>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>

          <!-- COMMENTS -->
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Commentaires en attente</h5>
              <a href="/admin/commentaires" class="btn-general">Voir tout</a>
            </div>

            <div class="admin-list">
              <% if (!pendingComments || pendingComments.length === 0) { %>
                <div class="admin-list-empty">Aucun commentaire</div>
              <% } %>

              <% pendingComments.forEach(c => { %>
                <div class="admin-list-item">
                  <div class="admin-list-content">

                    <strong><%= c.user?.name || 'Lecteur' %></strong>

                    <div class="admin-list-meta">
                      <% if (c.article) { %>
                        Sur : <a href="/article/<%= c.article.id %>"><%= c.article.title %></a>
                      <% } else { %>
                        Article supprimé
                      <% } %>
                    </div>

                    <div>
                      <%= c.content.substring(0, 80) %>...
                    </div>

                  </div>

                  <div class="admin-list-actions">

                    <form method="POST" action="/admin/commentaires/<%= c.id %>/approve">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="admin-btn-sm success">✓</button>
                    </form>

                    <form method="POST" action="/admin/commentaires/<%= c.id %>/reject">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button class="admin-btn-sm danger">✕</button>
                    </form>

                  </div>
                </div>
              <% }) %>
            </div>

            <%- include('partials/pagination', {
              pagination: commentsPagination,
              baseUrl: '/admin/dashboard'
            }) %>
          </div>

          <!-- SUBSCRIBERS -->
          <div class="admin-panel">
            <div class="admin-panel-header">
              <h5>Abonnés newsletter</h5>
              <a href="/admin/newsletter" class="btn-general">Gérer</a>
            </div>

            <div class="admin-list">
              <% if (!recentSubscribers || recentSubscribers.length === 0) { %>
                <div class="admin-list-empty">Aucun abonné</div>
              <% } %>

              <% recentSubscribers.forEach(s => { %>
                <div class="admin-list-item">
                  <div class="admin-list-content">
                    <strong><%= s.email %></strong>
                    <div class="admin-list-meta">
                      <%= new Date(s.created_at).toLocaleDateString() %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>

            <%- include('partials/pagination', {
              pagination: subscribersPagination,
              baseUrl: '/admin/dashboard'
            }) %>
          </div>

          <!-- CATEGORIES -->
         <div class="admin-panel">
  <div class="admin-panel-header">
    <h5>Catégories</h5>

    <div style="display:flex; gap:0.7rem; align-items:center;">
     

      <a href="/admin/categories/new" class="btn-general">
        Ajouter
      </a>
    </div>

  </div>

            <div class="admin-list">
              <% categories.forEach(cat => { %>
                <div class="admin-list-item">
                  <strong><%= cat.name %></strong>
                </div>
              <% }) %>
            </div>

            <%- include('partials/pagination', {
              pagination: categoriesPagination,
              baseUrl: '/admin/dashboard',
              pageParam: 'categoriesPage'
            }) %>
          </div>

        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>