<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header') %>
    <main class="container" style="max-width:500px; margin-top:80px;">
      <div class="card shadow-sm">
        <div class="card-body">
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="text-center mb-4">
              <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" class="bi bi-check-circle text-success" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
              </svg>
              <h2 class="mt-3 text-success">Désinscription réussie</h2>
              <p class="lead"><%= message %></p>
              <a href="/" class="btn btn-bd-primary mt-3">Retour à l'accueil</a>
            </div>
          <% } else { %>
            <h2 class="mb-4 text-center">Se désabonner de la newsletter</h2>
            
            <% if (typeof message !== 'undefined' && message) { %>
              <div class="alert alert-info alert-dismissible fade show" role="alert">
                <%= message %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>
            
            <% if (errors && errors.length > 0) { %>
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <ul class="mb-0">
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>
            
            <p class="text-muted mb-4">
              Nous sommes désolés de vous voir partir. Entrez votre adresse email pour vous désabonner de notre newsletter.
            </p>
            
            <form method="POST" action="/newsletter/unsubscribe">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="mb-3">
                <label for="email" class="form-label">Adresse email</label>
                <input type="email" class="form-control" id="email" name="email" 
                       value="<%= email || '' %>" required autocomplete="email"
                       placeholder="votre@email.com">
              </div>
              <button type="submit" class="btn btn-danger w-100">Me désabonner</button>
            </form>
            
            <div class="text-center mt-3">
              <a href="/" class="text-muted small">Retour à l'accueil</a>
            </div>
          <% } %>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
