<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="newsletter-page">
      <div class="newsletter-stage">
        <div class="newsletter-form-card">
          <span class="newsletter-eyebrow">La newsletter Emi’Pulse</span>
          <% if (typeof success !== 'undefined' && success) { %>
            <div class="newsletter-success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
              </svg>
              <h1 class="newsletter-form-title">Désinscription réussie</h1>
              <p class="newsletter-message"><%= message %></p>
              <a href="/" class="btn-smeg primary">Retour à l'accueil</a>
            </div>
          <% } else { %>
            <h1 class="newsletter-form-title">Se désabonner de la newsletter</h1>
            
            <% if (typeof message !== 'undefined' && message) { %>
              <div class="auth-alert info">
                <%= message %>
              </div>
            <% } %>
            
            <% if (errors && errors.length > 0) { %>
              <div class="auth-alert error">
                <ul>
                  <% errors.forEach(err => { %>
                    <li><%= err %></li>
                  <% }) %>
                </ul>
              </div>
            <% } %>
            
            <p class="newsletter-description">
              Nous sommes désolés de vous voir partir. Confirmez avec votre lien personnel, ou recevez un lien de désinscription par email.
            </p>
            
            <form method="POST" action="/newsletter/unsubscribe" class="newsletter-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <% if (token) { %>
              <input type="hidden" name="token" value="<%= token %>">
              <% } else { %>
              <div class="newsletter-form-group">
                <label for="email">Adresse email</label>
                <input type="email" id="email" name="email" 
                       value="<%= email || '' %>" required autocomplete="email"
                       placeholder="votre@email.com">
              </div>
              <% } %>
              <button type="submit" class="newsletter-submit"><%= token ? 'Confirmer ma désinscription' : 'Recevoir le lien' %></button>
            </form>
            
            <div class="newsletter-fineprint">
              <a href="/">Retour à l'accueil</a>
            </div>
          <% } %>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
