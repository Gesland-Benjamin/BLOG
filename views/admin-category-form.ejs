<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>

    <main class="admin-wrapper">
      <div class="admin-container-narrow">

        <div class="admin-panel">
          
          <div class="admin-panel-header">
            <h1 style="margin-bottom:0">
              <% if (category) { %>
                Éditer la catégorie
              <% } else { %>
                Ajouter une catégorie
              <% } %>
            </h1>
          </div>

          <div class="admin-panel-body">

            <% if (error) { %>
              <div class="admin-alert error" role="alert">
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            <% } %>

            <form
              method="POST"
              action="<%= category ? '/admin/categories/' + category.id + '?_method=PUT' : '/admin/categories' %>"
              class="admin-form"
            >

              <input type="hidden" name="_csrf" value="<%= csrfToken %>">

              <!-- NAME -->
              <div class="admin-form-group">
                <label for="name">Nom de la catégorie</label>

                <input
                  type="text"
                  class="admin-input"
                  id="name"
                  name="name"
                  value="<%= category ? category.name : (formData.name || '') %>"
                  required
                  placeholder="Ex: Beauté, Nutrition, Développement personnel"
                />

                <small class="admin-form-hint">
                  Minimum 3 caractères
                </small>
              </div>

              <!-- DESCRIPTION (optionnel) -->
              <div class="admin-form-group">
                <label for="description">Description (optionnel)</label>

                <textarea
                  id="description"
                  name="description"
                  class="admin-textarea"
                  placeholder="Description de la catégorie..."
                ><%= category ? (category.description || '') : (formData.description || '') %></textarea>
              </div>

              <!-- ACTIONS -->
              <div class="admin-form-actions">
                <button type="submit" class="admin-btn primary">
                  <% if (category) { %>
                    Mettre à jour
                  <% } else { %>
                    Créer
                  <% } %>
                </button>

                <a href="/admin/categories" class="admin-btn secondary">
                  Annuler
                </a>
              </div>

            </form>

          </div>
        </div>

      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>