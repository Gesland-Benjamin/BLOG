<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header-article') %>
    <main class="container" style="margin-top:60px;">
      <div class="row">
        <div class="col-md-6 offset-md-3">
          <h1 class="h3 mb-4">
            <% if (category) { %>
              Éditer la catégorie
            <% } else { %>
              Ajouter une catégorie
            <% } %>
          </h1>

          <% if (error) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <%= error %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <% if (errors && errors.length > 0) { %>
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
              <ul class="mb-0">
                <% errors.forEach(err => { %>
                  <li><%= err %></li>
                <% }) %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>

          <form method="POST" action="<%= category ? '/admin/categories/' + category.id + '?_method=PUT' : '/admin/categories' %>">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="mb-3">
              <label for="nom" class="form-label">Nom de la catégorie</label>
              <input
                type="text"
                class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('nom'))) ? 'is-invalid' : '' %>"
                id="nom"
                name="nom"
                value="<%= category ? category.nom : (formData.nom || '') %>"
                required
                placeholder="Ex: Beauté, Nutrition, Développement personnel"
              />
              <small class="form-text text-muted">Min 3 caractères</small>
            </div>

            <div class="d-flex gap-2">
              <button type="submit" class="btn btn-bd-primary">
                <% if (category) { %>
                  Mettre à jour
                <% } else { %>
                  Créer
                <% } %>
              </button>
              <a href="/admin/categories" class="btn btn-outline-secondary">Annuler</a>
            </div>
          </form>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
