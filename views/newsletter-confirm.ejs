<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header') %>
    <main class="container" style="max-width:600px; margin-top:80px;">
      <div class="row justify-content-center">
        <div class="col-md-10">
          <div class="card shadow-sm">
            <div class="card-body text-center p-5">
              <% if (success) { %>
                <div class="mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle text-success" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
                  </svg>
                </div>
                <h2 class="mb-4 text-success">✅ Inscription confirmée !</h2>
              <% } else { %>
                <div class="mb-4">
                  <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-exclamation-circle text-warning" viewBox="0 0 16 16">
                    <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                    <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                  </svg>
                </div>
                <h2 class="mb-4 text-warning">Attention</h2>
              <% } %>
              
              <p class="lead mb-4"><%= message %></p>
              
              <div class="d-grid gap-2">
                <a href="/" class="btn btn-bd-primary">Retour à l'accueil</a>
                <% if (success) { %>
                  <a href="/article" class="btn btn-outline-secondary">Découvrir nos articles</a>
                <% } else { %>
                  <a href="/newsletter" class="btn btn-outline-secondary">Réessayer</a>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
  </body>
</html>
