<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="content-wrapper">
      <div class="content-container">
        <div class="newsletter-form-card">
          <% if (success) { %>
            <div class="newsletter-success-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M10.97 4.97a.235.235 0 0 0-.02.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-1.071-1.05z"/>
              </svg>
            </div>
            <h2 class="newsletter-form-title">✅ Inscription confirmée !</h2>
          <% } else { %>
            <div class="newsletter-warning-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
              </svg>
            </div>
            <h2 class="newsletter-form-title">Attention</h2>
          <% } %>
          
          <p class="newsletter-message"><%= message %></p>
          
          <div class="error-actions">
            <a href="/" class="btn-smeg primary">Retour à l'accueil</a>
            <% if (success) { %>
              <a href="/article" class="btn-smeg secondary">Découvrir nos articles</a>
            <% } else { %>
              <a href="/newsletter" class="btn-smeg secondary">Réessayer</a>
            <% } %>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
