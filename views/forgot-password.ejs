<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header') %>
    <main class="container" style="margin-top: 60px;">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <div class="card border-0 shadow-sm">
            <div class="card-body p-5">
              <h2 class="text-center mb-4">Réinitialiser mon mot de passe</h2>

              <% if (error) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <%= error %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <ul class="mb-0">
                    <% errors.forEach(err => { %>
                      <li><%= err %></li>
                    <% }) %>
                  </ul>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <% if (message) { %>
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                  <%= message %>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <% if (devToken) { %>
                <div class="alert alert-warning" role="alert">
                  <strong>🔧 Développement :</strong> Token = <code><%= devToken %></code>
                </div>
              <% } %>

              <form method="POST" action="/auth/forgot">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                  <label for="email" class="form-label">Adresse email</label>
                  <input
                    type="email"
                    class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('email'))) ? 'is-invalid' : '' %>"
                    id="email"
                    name="email"
                    value="<%= formData.email || '' %>"
                    required
                    placeholder="votre@email.com"
                  />
                  <small class="form-text text-muted">
                    Un lien de réinitialisation vous sera envoyé si votre email est enregistré.
                  </small>
                </div>

                <button type="submit" class="btn btn-bd-primary w-100">
                  Envoyer le lien de réinitialisation
                </button>
              </form>

              <hr class="my-4">

              <p class="text-center mb-0">
                Vous vous souvenez de votre mot de passe ?
                <a href="/auth">Se connecter</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
