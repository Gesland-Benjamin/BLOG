<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="auth-wrapper">
      <div class="auth-container">
        <div class="auth-form-card">
          <h2>Réinitialiser mon mot de passe</h2>

          <% if (error) { %>
            <div class="auth-alert error"><%= error %></div>
          <% } %>

          <% if (errors && errors.length > 0) { %>
            <div class="auth-alert error">
              <ul>
                <% errors.forEach(err => { %>
                  <li><%= err %></li>
                <% }) %>
              </ul>
            </div>
          <% } %>

          <% if (message) { %>
            <div class="auth-alert info"><%= message %></div>
          <% } %>

          <% if (devToken) { %>
            <div class="auth-alert warning">
              <strong>🔧 Développement :</strong> Token = <code><%= devToken %></code>
            </div>
          <% } %>

          <form method="POST" action="/auth/forgot" class="auth-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="auth-form-group">
              <label for="email">Adresse email</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= formData.email || '' %>"
                required
                placeholder="votre@email.com"
              />
              <small>
                Un lien de réinitialisation vous sera envoyé si votre email est enregistré.
              </small>
            </div>

            <button type="submit" class="auth-submit-btn">
              Envoyer le lien de réinitialisation
            </button>
          </form>

          <div class="auth-divider">OU</div>

          <p class="auth-footer">
            Vous vous souvenez de votre mot de passe ?
            <a href="/auth">Se connecter</a>
          </p>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
