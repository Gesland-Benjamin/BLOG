<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header') %>
    <main class="container" style="margin-top:80px;">
      <div class="row">
        <div class="col-12">
          <div class="d-flex justify-content-between align-items-center mb-4">
            <h1>📧 Gestion de la newsletter</h1>
            <a href="/admin/dashboard" class="btn btn-outline-secondary">← Retour au dashboard</a>
          </div>

          <!-- Statistiques -->
          <div class="row mb-4">
            <div class="col-md-4">
              <div class="card text-center">
                <div class="card-body">
                  <h3 class="text-primary"><%= stats.total %></h3>
                  <p class="mb-0">Total d'abonnés</p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card text-center">
                <div class="card-body">
                  <h3 class="text-success"><%= stats.confirmed %></h3>
                  <p class="mb-0">Confirmés</p>
                </div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="card text-center">
                <div class="card-body">
                  <h3 class="text-warning"><%= stats.pending %></h3>
                  <p class="mb-0">En attente</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Boutons d'export -->
          <div class="card mb-4">
            <div class="card-body">
              <h5 class="card-title">Export CSV</h5>
              <p class="text-muted">Télécharger la liste des abonnés au format CSV</p>
              <div class="btn-group" role="group">
                <a href="/admin/newsletter/export?status=all" class="btn btn-primary">
                  📥 Tous les abonnés
                </a>
                <a href="/admin/newsletter/export?status=confirmed" class="btn btn-success">
                  ✅ Confirmés uniquement
                </a>
                <a href="/admin/newsletter/export?status=pending" class="btn btn-warning">
                  ⏳ En attente uniquement
                </a>
              </div>
            </div>
          </div>

          <% if (typeof message !== 'undefined' && message) { %>
            <div class="alert alert-success alert-dismissible fade show" role="alert">
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% } %>

          <!-- Liste des abonnés -->
          <div class="card">
            <div class="card-header">
              <h5 class="mb-0">Liste des abonnés (<%= subscribers.length %>)</h5>
            </div>
            <div class="card-body">
              <% if (subscribers.length === 0) { %>
                <p class="text-muted text-center py-5">Aucun abonné pour le moment.</p>
              <% } else { %>
                <div class="table-responsive">
                  <table class="table table-hover">
                    <thead>
                      <tr>
                        <th>Email</th>
                        <th>Statut</th>
                        <th>Date d'inscription</th>
                        <th>Date de confirmation</th>
                        <th>Utilisateur</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% subscribers.forEach(sub => { %>
                        <tr>
                          <td><%= sub.email %></td>
                          <td>
                            <% if (sub.confirmed) { %>
                              <span class="badge bg-success">✅ Confirmé</span>
                            <% } else { %>
                              <span class="badge bg-warning text-dark">⏳ En attente</span>
                            <% } %>
                          </td>
                          <td>
                            <small class="text-muted">
                              <%= new Date(sub.date_inscription).toLocaleDateString('fr-FR') %>
                            </small>
                          </td>
                          <td>
                            <% if (sub.confirmed_at) { %>
                              <small class="text-muted">
                                <%= new Date(sub.confirmed_at).toLocaleDateString('fr-FR') %>
                              </small>
                            <% } else { %>
                              <small class="text-muted">-</small>
                            <% } %>
                          </td>
                          <td>
                            <% if (sub.user) { %>
                              <small><%= sub.user.nom_prenom %></small>
                            <% } else { %>
                              <small class="text-muted">-</small>
                            <% } %>
                          </td>
                          <td class="text-end">
                            <div class="btn-group btn-group-sm">
                              <% if (!sub.confirmed) { %>
                                <button class="btn btn-outline-primary" 
                                        onclick="resendConfirmation(<%= sub.id %>)"
                                        title="Renvoyer l'email de confirmation">
                                  📧
                                </button>
                              <% } %>
                              <form method="POST" action="/admin/newsletter/<%= sub.id %>?_method=DELETE" 
                                    style="display:inline;"
                                    onsubmit="return confirm('Supprimer cet abonné ?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                  🗑️
                                </button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/pagination', { pagination, baseUrl }) %>
    </main>

    <script>
      async function resendConfirmation(id) {
        if (!confirm('Renvoyer l\'email de confirmation ?')) return;
        
        try {
          const response = await fetch(`/admin/newsletter/${id}/resend`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': '<%= csrfToken %>'
            }
          });
          
          const data = await response.json();
          
          if (data.success) {
            alert('Email de confirmation renvoyé avec succès !');
          } else {
            alert('Erreur : ' + (data.error || 'Une erreur est survenue'));
          }
        } catch (error) {
          console.error('Erreur:', error);
          alert('Erreur lors de l\'envoi de l\'email');
        }
      }
    </script>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
