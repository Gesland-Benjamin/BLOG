<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>📧 Gestion de la newsletter</h1>
          <a href="/admin/dashboard" class="admin-btn secondary">← Retour au dashboard</a>
        </div>

        <!-- Statistiques -->
        <div class="admin-stats-grid simple">
          <div class="admin-stat-card primary">
            <div class="admin-stat-value"><%= stats.total %></div>
            <p>Total d'abonnés</p>
          </div>
          <div class="admin-stat-card success">
            <div class="admin-stat-value"><%= stats.confirmed %></div>
            <p>Confirmés</p>
          </div>
          <div class="admin-stat-card warning">
            <div class="admin-stat-value"><%= stats.pending %></div>
            <p>En attente</p>
          </div>
        </div>

        <!-- Boutons d'export -->
        <div class="admin-panel">
          <div class="admin-panel-content">
            <h5>Export CSV</h5>
            <p>Télécharger la liste des abonnés au format CSV</p>
            <div class="admin-export-buttons">
              <a href="/admin/newsletter/export?status=all" class="admin-btn primary">
                📥 Tous les abonnés
              </a>
              <a href="/admin/newsletter/export?status=confirmed" class="admin-btn success">
                ✅ Confirmés uniquement
              </a>
              <a href="/admin/newsletter/export?status=pending" class="admin-btn warning">
                ⏳ En attente uniquement
              </a>
            </div>
          </div>
        </div>

        <% if (typeof message !== 'undefined' && message) { %>
          <div class="admin-alert success" role="alert">
            <%= message %>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        <% } %>

        <!-- Liste des abonnés -->
        <div class="admin-table-card">
          <div class="admin-table-header">
            <h5>Liste des abonnés (<%= subscribers.length %>)</h5>
          </div>
          <div class="admin-table-content">
            <% if (subscribers.length === 0) { %>
              <p class="admin-empty-state">Aucun abonné pour le moment.</p>
            <% } else { %>
              <div class="admin-table-responsive">
                <table class="admin-table">
                  <thead>
                    <tr>
                        <th>Email</th>
                        <th>Statut</th>
                        <th>Date d'inscription</th>
                        <th>Date de confirmation</th>
                        <th>Utilisateur</th>
                        <th class="text-end">Actions</th>
                      </tr>
                    </thead>
                    <tbody>
                      <% subscribers.forEach(sub => { %>
                        <tr>
                          <td><%= sub.email %></td>
                          <td>
                            <% if (sub.confirmed) { %>
                              <span class="badge bg-success">✅ Confirmé</span>
                            <% } else { %>
                              <span class="badge bg-warning text-dark">⏳ En attente</span>
                            <% } %>
                          </td>
                          <td>
                            <small class="text-muted">
                              <%= new Date(sub.date_inscription).toLocaleDateString('fr-FR') %>
                            </small>
                          </td>
                          <td>
                            <% if (sub.confirmed_at) { %>
                              <small class="text-muted">
                                <%= new Date(sub.confirmed_at).toLocaleDateString('fr-FR') %>
                              </small>
                            <% } else { %>
                              <small class="text-muted">-</small>
                            <% } %>
                          </td>
                          <td>
                            <% if (sub.user) { %>
                              <small><%= sub.user.nom_prenom %></small>
                            <% } else { %>
                              <small class="text-muted">-</small>
                            <% } %>
                          </td>
                          <td class="text-end">
                            <div class="btn-group btn-group-sm">
                              <% if (!sub.confirmed) { %>
                                <button class="btn btn-outline-primary" 
                                        onclick="resendConfirmation(<%= sub.id %>)"
                                        title="Renvoyer l'email de confirmation">
                                  📧
                                </button>
                              <% } %>
                              <form method="POST" action="/admin/newsletter/<%= sub.id %>?_method=DELETE" 
                                    style="display:inline;"
                                    onsubmit="return confirm('Supprimer cet abonné ?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-outline-danger btn-sm" title="Supprimer">
                                  🗑️
                                </button>
                              </form>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <%- include('partials/pagination', { pagination, baseUrl }) %>
    </main>

    <script>
      async function resendConfirmation(id) {
        if (!confirm('Renvoyer l\'email de confirmation ?')) return;
        
        try {
          const response = await fetch(`/admin/newsletter/${id}/resend`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-CSRF-Token': '<%= csrfToken %>'
            }
          });
          
          const data = await response.json();
          
          if (data.success) {
            alert('Email de confirmation renvoyé avec succès !');
          } else {
            alert('Erreur : ' + (data.error || 'Une erreur est survenue'));
          }
        } catch (error) {
          console.error('Erreur:', error);
          alert('Erreur lors de l\'envoi de l\'email');
        }
      }
    </script>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
