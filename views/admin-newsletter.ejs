<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header') %>
    <main class="admin-wrapper">
      <div class="admin-container">
        <div class="admin-header">
          <h1>📧 Gestion de la newsletter</h1>
          <a href="/admin/dashboard" class="btn-general">← Retour au dashboard</a>
        </div>

        <!-- Statistiques -->
        <div class="admin-stats-grid simple">
          <div class="admin-stat-card primary">
            <div class="admin-stat-value"><%= stats.total %></div>
            <p>Total d'abonnés</p>
          </div>
          <div class="admin-stat-card success">
            <div class="admin-stat-value"><%= stats.confirmed %></div>
            <p>Confirmés</p>
          </div>
          <div class="admin-stat-card warning">
            <div class="admin-stat-value"><%= stats.pending %></div>
            <p>En attente</p>
          </div>
        </div>

        <!-- Export -->
        <div class="admin-panel">
          <div class="admin-panel-content">
            <h5>Export CSV</h5>
            <p>Télécharger la liste des abonnés</p>
            <div class="admin-export-buttons">
              <a href="/admin/newsletter/export?status=all" class="admin-btn primary">📥 Tous</a>
              <a href="/admin/newsletter/export?status=confirmed" class="admin-btn success">✅ Confirmés</a>
              <a href="/admin/newsletter/export?status=pending" class="admin-btn warning">⏳ En attente</a>
            </div>
          </div>
        </div>

        <% if (message) { %>
          <div class="admin-alert success">
            <%= message.text %>
          </div>
        <% } %>

        <!-- TABLE -->
        <div class="admin-table-card">
          <div class="admin-table-header">
            <h5>Abonnés (<%= subscribers.length %>)</h5>
          </div>

          <% if (subscribers.length === 0) { %>
            <p>Aucun abonné</p>
          <% } else { %>

          <table class="admin-table">
            <thead>
              <tr>
                <th>Email</th>
                <th>Statut</th>
                <th>Date</th>
                <th>Utilisateur</th>
                <th>Actions</th>
              </tr>
            </thead>

            <tbody>
              <% subscribers.forEach(sub => { %>
                <tr>
                  <td><%= sub.email %></td>

                  <td>
                    <% if (sub.confirmed) { %>
                      ✅
                    <% } else { %>
                      ⏳
                    <% } %>
                  </td>

                  <td>
                    <%= new Date(sub.date_inscription).toLocaleDateString('fr-FR') %>
                  </td>

                  <td>
                    <%= sub.user ? sub.user.name : "-" %>
                  </td>

                  <td>
                    <!-- DELETE FIX -->
                    <form method="POST" action="/admin/newsletter/<%= sub.id %>">
                      <input type="hidden" name="_method" value="DELETE">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                      <button type="submit">🗑️</button>
                    </form>
                  </td>

                </tr>
              <% }) %>
            </tbody>
          </table>

          <% } %>
        </div>
      </div>
    </main>

    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>