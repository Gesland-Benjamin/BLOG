<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="content-container">
        <h1 class="page-title">Recherche d'articles</h1>

        <div class="search-form-card">
          <form method="GET" action="/search" class="search-form">
            <div class="search-form-grid">
              <div class="search-form-group">
                <label for="q">Recherche par titre</label>
                <input type="search" name="q" id="q" placeholder="Titre de l'article..." value="<%= filters.q %>">
              </div>
              <div class="search-form-group">
                <label for="categorie">Catégorie</label>
                <select name="categorie" id="categorie">
                  <option value="">Toutes</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= filters.categorie == cat.id ? 'selected' : '' %>><%= cat.nom %></option>
                  <% }) %>
                </select>
              </div>
              <div class="search-form-submit-wrapper">
                <button type="submit" class="search-submit">Rechercher</button>
              </div>
            </div>
          </form>
        </div>

        <% if (filters.q || filters.categorie || filters.auteur) { %>
          <p class="search-results-count">
            <%= pagination.total %> résultat<%= pagination.total > 1 ? 's' : '' %> trouvé<%= pagination.total > 1 ? 's' : '' %>
          </p>
        <% } %>

        <% if (articles.length === 0) { %>
          <div class="search-no-results">Aucun article trouvé. Essayez de modifier vos critères de recherche.</div>
        <% } else { %>
          <div class="article-grid">
            <% articles.forEach(article => { %>
              <article class="article-card">
                <% if (article.image) { %>
                  <div class="article-card-image">
                    <img src="<%= article.image %>" alt="<%= article.titre %>">
                  </div>
                <% } %>
                <div class="article-card-content">
                  <h5 class="article-card-title"><%= article.titre %></h5>
                  <p class="article-card-excerpt"><%= (article.contenu || '').substring(0, 120) %>...</p>
                  <div class="article-card-meta">
                    Par <%= article.auteur %> — <%= new Date(article.date_publication).toLocaleDateString() %>
                    <% if (article.categorie) { %> — <strong><%= article.categorie %></strong><% } %>
                  </div>
                  <div class="article-card-actions">
                    <a href="/article/<%= article.id %>" class="article-card-btn">Lire l'article</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

        <%- include('partials/pagination', { pagination, baseUrl }) %>
      <% } %>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
