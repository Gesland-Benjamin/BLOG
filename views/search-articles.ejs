<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper article-search-page">

      <div class="search-header-flex">
        
        <section class="search-form-card" aria-labelledby="article-search-title">
          <div class="search-form-heading">
            <span class="search-form-eyebrow">Le blog Emi’Pulse</span>
            <h1 id="article-search-title">Une envie de lecture ?</h1>
            <p>Un mot-clé, une catégorie… trouvez l’article qui vous parle.</p>
          </div>
          <form method="GET" action="/search" class="search-form">
            <div class="search-form-grid">
              <div class="search-form-group">
                <label for="q">Que recherchez-vous ?</label>
                <input type="search" name="q" id="q" placeholder="Un titre, un mot-clé…" value="<%= filters.q %>">
              </div>
              <div class="search-form-group">
                <label for="categorie">Catégorie</label>
                <select name="categorie" id="categorie">
                  <option value="">Toutes les catégories</option>
                  <% categories.forEach(cat => { %>
                    <option value="<%= cat.id %>" <%= filters.categorie == cat.id ? 'selected' : '' %>><%= cat.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="search-form-group search-form-action">
                <button type="submit" class="search-form-button"><i class="bi bi-search" aria-hidden="true"></i> Rechercher</button>
              </div>
            </div>
          </form>
        </section>
      </div>

        <% if (filters.q || filters.categorie || filters.auteur) { %>
          <p class="search-results-count">
            <%= pagination.total %> résultat<%= pagination.total > 1 ? 's' : '' %> trouvé<%= pagination.total > 1 ? 's' : '' %>
          </p>
        <% } %>

        <% if (articles.length === 0) { %>
          <div class="search-no-results">Aucun article trouvé. Essayez de modifier vos critères de recherche.</div>
        <% } else { %>
          <div class="archive-articles">
            <% articles.forEach(article => { %>
              <article class="archive-article-card">
                <div class="archive-article-layout">
                  <% if (article.image) { %>
                    <div class="archive-article-image">
                      <img src="<%= article.image %>" alt="<%= article.titre %>">
                    </div>
                  <% } %>
                  <div class="archive-article-content <%= article.image ? '' : 'full-width' %>">
                    <h2 class="archive-article-title">
                      <a href="/article/<%= article.id %>"><%= article.titre %></a>
                    </h2>
                    <p class="archive-article-meta">
                      <% if (article.categorie) { %><strong><%= article.categorie %></strong> | <% } %>
                      <%= article.date_publication_formatted || '' %>
                    </p>
                    <p class="archive-article-excerpt"><%= (article.contenu || '').substring(0, 200) %>...</p>
                    <a href="/article/<%= article.id %>" class="archive-article-btn">Lire la suite →</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>

        <%- include('partials/pagination', { pagination, baseUrl }) %>
      <% } %>

    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
