<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="article-detail-container">
        <nav aria-label="Fil d’Ariane" class="seo-breadcrumb">
          <ol>
            <% breadcrumbs.forEach((item, index) => { %>
              <li>
                <% if (index > 0) { %><span class="seo-breadcrumb-separator" aria-hidden="true">›</span><% } %>
                <% if (index < breadcrumbs.length - 1) { %>
                  <a href="<%= item.path %>"><%= item.name %></a>
                <% } else { %>
                  <span class="seo-breadcrumb-current" aria-current="page"><%= item.name %></span>
                <% } %>
              </li>
            <% }) %>
          </ol>
        </nav>
        <article class="article-detail-card">
          <% if (article.image) { %>
            <div class="article-detail-image">
              <img
                src="<%= article.image %>"
                alt="<%= article.image_alt || article.titre %>"
                title="<%= article.titre %>"
                <% if (article.imageDimensions) { %>width="<%= article.imageDimensions.width %>" height="<%= article.imageDimensions.height %>"<% } %>
                <% if (article.imageSrcset) { %>srcset="<%= article.imageSrcset %>" sizes="(max-width: 900px) 100vw, 900px"<% } %>
                loading="eager" fetchpriority="high"


              >
            </div>
          <% } %>
          <div class="article-detail-content">
            <p class="article-detail-date"><% if (article.date_publication_iso) { %>Publié le <time datetime="<%= article.date_publication_iso %>"><%= article.date_publication_formatted %></time><% } %>
            <% if (article.date_modified_iso && article.date_modified_iso !== article.date_publication_iso) { %> · Mis à jour le <time datetime="<%= article.date_modified_iso %>"><%= article.date_modified_formatted %></time><% } %></p>
            <h1 class="article-detail-title" style="text-align: left;"><%= article.titre %></h1>
            <p class="article-detail-meta">Par <strong><%= article.auteur %></strong><% if (article.categorie) { %> — <strong><%= article.categorie %></strong><% } %></p>
            <% if (toc.length) { %><nav class="article-toc" aria-label="Sommaire"><h2>Dans cet article</h2><ol><% toc.forEach(item => { %><li><a href="#<%= item.id %>"><%= item.label %></a></li><% }) %></ol></nav><% } %>
            <div class="article-detail-body">
              <%- article.contenuHtml %>
            </div>

            <% if (article.image_inline && !article.inlineImagePlacedInContent) { %>
              <div class="article-inline-image" style="margin-top: 2rem; margin-bottom: 1.5rem;">
                <img src="<%= article.image_inline %>"
                     alt="<%= article.image_alt || article.titre %>"
                     <% if (article.inlineDimensions) { %>width="<%= article.inlineDimensions.width %>" height="<%= article.inlineDimensions.height %>"<% } %>
                     <% if (article.inlineSrcset) { %>srcset="<%= article.inlineSrcset %>" sizes="(max-width: 900px) 100vw, 900px"<% } %>
                     loading="lazy"

                     style="max-width: 100%; height: auto; border-radius: 12px; box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);">
              </div>
            <% } %>

            <% if (article.video) { %>
              <div style="margin-top: 1.2rem;"></div>
              <div class="article-detail-video">
                <div class="video-container">
                  <% if (article.videoType === 'youtube') { %>
                    <!-- YouTube iframe -->
                    <iframe loading="lazy" title="Vidéo de l’article"
                      src="<%= article.video %>"
                      frameborder="0"
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen>
                    </iframe>
                  <% } else if (article.videoType === 'vimeo') { %>
                    <!-- Vimeo iframe -->
                    <iframe loading="lazy" title="Vidéo de l’article"
                      src="<%= article.video %>"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture"
                      allowfullscreen>
                    </iframe>
                  <% } else { %>
                    <!-- HTML5 video player for direct video files -->
                    <video controls>
                      <source src="<%= article.video %>" type="video/mp4">
                      Votre navigateur ne supporte pas la lecture vidéo.
                    </video>
                  <% } %>
                </div>
              </div>
            <% } %>

            <div class="article-detail-actions" style="padding-bottom: 15px;">
              <button
                id="like-btn"
                class="heart-button article-like-button <%= article.liked ? 'liked' : '' %>"
                data-article-id="<%= article.id %>"
                <%= article.liked ? 'disabled' : '' %>
              >
                <img src="/Boutton_coeur-Photoroom.webp" width="1024" height="1024" alt="J'aime" class="article-like-icon" />
                <span class="article-like-label <%= article.liked ? 'is-thanked' : '' %>">
                  <%= article.liked ? "Merci" : "J'aime" %>
                </span>
              </button>
              <span id="like-count" class="article-like-count">
                <%= article.likes %> j'aime<%= article.likes > 1 ? 's' : '' %>
              </span>
              <% if (user && user.role && user.role.toLowerCase() === 'admin') { %>
                <div style="display:inline-flex; gap:0.5rem; align-items:center; flex-wrap:wrap; margin-left:1rem;">
                  <a href="/admin/articles/<%= article.id %>/edit" class="admin-btn-sm secondary">Éditer</a>
                  <form method="POST" action="/admin/articles/<%= article.id %>?_method=DELETE" style="display:inline-block; margin:0;">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="admin-btn-sm danger" data-confirm="Supprimer cet article ?">Supprimer</button>
                  </form>
                </div>
              <% } %>
            </div>

            <p class="article-reader-invitation">Et vous, quelle est votre expérience ? <a href="#commentaires">Partagez-la en commentaire</a> ou <a href="/newsletter">retrouvez les prochains articles par email</a>.</p>
            <div class="article-detail-links">
              <% if (article.categorie) { %><a href="/article/categorie/<%= encodeURIComponent(article.categorie) %>" class="btn-general">Retour à la catégorie</a><% } %>
              <a href="/article" class="btn-general">Tous les articles</a>
            </div>
          </div>
        </article>

        <% if (typeof articleSeries !== 'undefined') { articleSeries.forEach(series => { %>
          <nav class="article-detail-card article-series" aria-label="Série : <%= series.title %>">
            <div class="article-detail-content">
              <h2>Dans la série « <%= series.title %> »</h2>
              <ol><% series.articles.forEach(episode => { %><li>
                <% if (episode.slug === article.slug) { %><span aria-current="page"><%= episode.title %></span><% } else { %><a href="<%= articlePath(episode) %>"><%= episode.title %></a><% } %>
              </li><% }) %></ol>
            </div>
          </nav>
        <% }); } %>
        <% if (relatedArticles.length) { %>
          <section class="article-detail-card" aria-labelledby="related-articles-title">
            <div class="article-detail-content">
              <h2 id="related-articles-title">À lire aussi</h2>
              <ul>
                <% relatedArticles.forEach(item => { %>
                  <li><a href="<%= articlePath(item) %>"><%= item.title %></a></li>
                <% }) %>
              </ul>
            </div>
          </section>
        <% } %>
        <section class="comments-section" id="commentaires">
          <div class="comments-content">
            <div class="comments-header">
              <h2>Commentaires</h2>
              <span class="comments-count"><%= commentaires.length %> commentaire<%= commentaires.length > 1 ? 's' : '' %></span>
            </div>

            <% if (commentaires.length === 0) { %>
              <p class="comments-empty">Soyez le premier à commenter cet article.</p>
            <% } else { %>
              <div class="comments-list">
                <% commentaires.forEach((c, index) => { %>
                  <article class="comment-item" aria-label="Commentaire <%= index + 1 %>">
                    <div class="comment-item-body">
                      <div class="comment-item-header comment-item-header-compact">
                        <strong class="comment-author"><%= c.nom || 'Lecteur' %></strong>
                      </div>

                      <p class="comment-body"><%= c.contenu %></p>

                      <% if (c.replies && c.replies.length > 0) { %>
                        <div class="comment-replies">
                          <% if (c.replies.length <= 3) { %>
                            <% c.replies.forEach(reply => { %>
                              <div class="comment-reply">
                                <div class="comment-item-header comment-item-header-compact">
                                  <strong class="comment-author">
                                    <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Emilie Delbe') %>
                                    <% if (reply.is_admin_reply) { %>
                                      <span class="badge text-bg-primary comment-admin-badge">Emilie Delbe</span>
                                    <% } %>
                                  </strong>
                                </div>
                                <p class="comment-body comment-body-reply"><%= reply.contenu %></p>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <div class="accordion comment-replies-accordion" id="accordion-comment-<%= c.id %>">
                              <div class="accordion-item comment-accordion-item">
                                <h2 class="accordion-header">
                                  <button class="accordion-button collapsed comment-replies-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-comment-<%= c.id %>">
                                    <span>Voir les <%= c.replies.length %> réponses</span>
                                  </button>
                                </h2>
                                <div id="collapse-comment-<%= c.id %>" class="accordion-collapse collapse" data-bs-parent="#accordion-comment-<%= c.id %>">
                                  <div class="accordion-body comment-accordion-body">
                                    <% c.replies.forEach(reply => { %>
                                      <div class="comment-reply">
                                        <div class="comment-item-header comment-item-header-compact">
                                          <strong class="comment-author">
                                            <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Emilie.D') %>
                                            <% if (reply.is_admin_reply) { %>
                                              <span class="badge text-bg-primary comment-admin-badge">ADMIN</span>
                                            <% } %>
                                          </strong>
                                        </div>
                                        <p class="comment-body comment-body-reply"><%= reply.contenu %></p>
                                      </div>
                                    <% }) %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                  </article>
                <% }) %>
                </div>
              <% } %>

              <!-- Pagination des commentaires en dehors de la boucle -->
              <%- include('partials/pagination', { pagination: commentsPagination, baseUrl: commentsBaseUrl }) %>

              <% if (typeof commentSubmitted !== 'undefined' && commentSubmitted) { %>
                <div id="comment-success-alert" class="alert alert-success">Merci ! Votre commentaire est en attente de validation.</div>
                <script nonce="<%= cspNonce %>">
                  setTimeout(function() {
                    var alert = document.getElementById('comment-success-alert');
                    if(alert) alert.style.display = 'none';
                  }, 3000);
                  if(window.history.replaceState) {
                    window.history.replaceState(null, null, window.location.pathname + window.location.search);
                  }
                </script>
              <% } %>

              <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <ul class="mb-0">
                    <% errors.forEach(err => { %>
                      <li><%= err %></li>
                    <% }) %>
                  </ul>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <form method="POST" action="/article/<%= article.id %>/comment">
<input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <% if (!user) { %>
                  <div class="mb-3">
                    <label for="nom" class="form-label">Votre nom</label>
                    <input type="text" class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('nom'))) ? 'is-invalid' : '' %>"
                           id="nom" name="nom" value="<%= formData.nom || '' %>" required>
                    <small class="form-text text-muted">Min 3 caractères</small>
                  </div>
                <% } %>
                <div class="mb-3">
                  <label for="contenu" class="form-label">Votre commentaire</label>
                  <textarea class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('commentaire'))) ? 'is-invalid' : '' %>"
                            id="contenu" name="contenu" rows="4" required><%= formData.contenu || '' %></textarea>
                  <small class="form-text text-muted">Min 10 caractères</small>
                </div>
                <button type="submit" class="btn-general">Publier mon commentaire</button>
                <p class="text-muted small mt-2 mb-0">Les commentaires sont modérés avant publication.</p>
              </form>
            </div>
          </section>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script nonce="<%= cspNonce %>">
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('like-btn');
        const countEl = document.getElementById('like-count');

        if (!btn || !countEl) return;

        const articleId = btn.dataset.articleId;

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          const label = btn.querySelector('.article-like-label');
          if (label) label.textContent = 'Merci !';

          try {
            const response = await fetch(`/article/${articleId}/like`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'x-csrf-token': '<%= csrfToken %>'
              }
            });

            const data = await response.json().catch(() => ({}));
            if (response.status === 400 && data.message === 'Vous avez déjà liké cet article') {
              btn.classList.add('liked');
              if (label) label.textContent = 'Merci';
              return;
            }

            if (!response.ok) {
              const fallback = response.status === 403
                ? 'Votre session a expiré. Rechargez la page avant de réessayer.'
                : response.status === 429
                  ? 'Trop de tentatives. Veuillez patienter avant de réessayer.'
                  : 'Impossible d’enregistrer votre like pour le moment. Réessayez plus tard.';
              throw new Error(data.message || data.error || fallback);
            }

            const total = data.likes ?? 0;
            countEl.textContent = `${total} j'aime${total > 1 ? 's' : ''}`;
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
          } catch (error) {
            console.error('Erreur lors du like:', error);
            btn.disabled = false;
            if (label) label.textContent = "J'aime";
            alert(error.message || "Impossible d'enregistrer votre j'aime pour le moment. Merci de réessayer.");
          }
        });
      });
    </script>
    <script nonce="<%= cspNonce %>">
      document.addEventListener('DOMContentLoaded', function() {
        var commentsList = document.querySelector('.comments-list');
        if (commentsList && commentsList.children.length > 2) {
          commentsList.style.maxHeight = '220px';
          commentsList.style.overflowY = 'auto';
          commentsList.style.paddingRight = '8px';
        } else if (commentsList) {
          commentsList.style.maxHeight = '';
          commentsList.style.overflowY = '';
          commentsList.style.paddingRight = '';
        }
      });
    </script>
  </body>
</html>
