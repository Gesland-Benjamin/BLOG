<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <main class="content-wrapper">
      <div class="article-detail-container">
        <article class="article-detail-card">
          <% if (article.image) { %>
            <div class="article-detail-image">
              <img 
                src="<%= article.image %>" 
                alt="<%= article.image_alt || article.titre %>"
                title="<%= article.titre %>"
                loading="lazy"
                srcset="<%= article.image %> 600w, <%= article.image.replace('_md', '_lg') %> 1200w"
               
              >
            </div>
          <% } %>
          <div class="article-detail-content">
            <p class="article-detail-date"><%= new Date(article.date_publication).toLocaleDateString() %></p>
            <h1 class="article-detail-title" style="text-align: left;"><%= article.titre %></h1>
            <p class="article-detail-meta">Par <strong><%= article.auteur %></strong><% if (article.categorie) { %> — <strong><%= article.categorie %></strong><% } %></p>
            <div class="article-detail-body">
              <%= article.contenu %>
            </div>

            <% if (article.video) { %>
              <div style="margin-top: 1.2rem;"></div>
              <div class="article-detail-video">
                <div class="video-container">
                  <% if (article.videoType === 'youtube') { %>
                    <!-- YouTube iframe -->
                    <iframe 
                      src="<%= article.video %>" 
                      frameborder="0" 
                      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                      referrerpolicy="strict-origin-when-cross-origin"
                      allowfullscreen>
                    </iframe>
                  <% } else if (article.videoType === 'vimeo') { %>
                    <!-- Vimeo iframe -->
                    <iframe 
                      src="<%= article.video %>" 
                      frameborder="0" 
                      allow="autoplay; fullscreen; picture-in-picture" 
                      allowfullscreen>
                    </iframe>
                  <% } else { %>
                    <!-- HTML5 video player for direct video files -->
                    <video controls>
                      <source src="<%= article.video %>" type="video/mp4">
                      Votre navigateur ne supporte pas la lecture vidéo.
                    </video>
                  <% } %>
                </div>
              </div>
            <% } %>

            <div class="article-detail-actions" style="padding-bottom: 15px;">
              <button
                id="like-btn"
                class="heart-button article-like-button <%= article.liked ? 'liked' : '' %>"
                data-article-id="<%= article.id %>"
                <%= article.liked ? 'disabled' : '' %>
              >
                <img src="/Boutton_coeur-Photoroom.png" alt="J'aime" class="article-like-icon" />
                <span class="article-like-label <%= article.liked ? 'is-thanked' : '' %>">
                  <%= article.liked ? "Merci" : "J'aime" %>
                </span>
              </button>
              <span id="like-count" class="article-like-count">
                <%= article.likes %> j'aime<%= article.likes > 1 ? 's' : '' %>
              </span>
              <% if (user && user.role === 'admin') { %>
                <form method="POST" action="/admin/articles/<%= article.id %>?_method=DELETE" style="display:inline-block;margin-left:1rem;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="admin-btn-sm danger" onclick="return confirm('Supprimer cet article ?')">Supprimer</button>
                </form>
              <% } %>
            </div>

            <div class="article-detail-links">
              <a href="/article/categorie/<%= encodeURIComponent(article.categorie || '') %>" class="btn-general">Retour à la catégorie</a>
              <a href="/article" class="btn-general">Tous les articles</a>
            </div>
          </div>
        </article>

        <section class="comments-section">
          <div class="comments-content">
            <div class="comments-header">
              <h2>Commentaires</h2>
              <span class="comments-count"><%= commentaires.length %> commentaire<%= commentaires.length > 1 ? 's' : '' %></span>
            </div>

            <% if (commentaires.length === 0) { %>
              <p class="comments-empty">Soyez le premier à commenter cet article.</p>
            <% } else { %>
              <div class="comments-list">
                <% commentaires.forEach(c => { %>
                  <div class="comment-item">
                    <div class="comment-header">
                      <strong class="comment-author"><%= c.nom || 'Lecteur' %></strong>
                      <span class="comment-date"><%= new Date(c.date).toLocaleDateString() %></span>
                    </div>
                      <p class="mb-1"><%= c.contenu %></p>
                      
                      <!-- Affichage des réponses -->
                      <% if (c.replies && c.replies.length > 0) { %>
                        <div class="mt-3 pt-2 border-top">
                          <% if (c.replies.length <= 3) { %>
                            <!-- Afficher toutes les réponses si 3 ou moins -->
                            <% c.replies.forEach(reply => { %>
                              <div class="ms-4 mb-2 p-2 bg-light rounded">
                                <div class="d-flex justify-content-between">
                                  <small class="fw-bold text-primary">
                                    <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                                    <% if (reply.is_admin_reply) { %>
                                      <span class="badge text-bg-primary" style="font-size:0.65rem;">ADMIN</span>
                                    <% } %>
                                  </small>
                                  <small class="text-muted"><%= new Date(reply.date).toLocaleDateString() %></small>
                                </div>
                                <p class="mb-0 mt-1 small"><%= reply.contenu %></p>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <!-- Menu déroulant si plus de 3 réponses -->

                            <div class="accordion accordion-flush" id="accordion-comment-<%= c.id %>">
                              <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                  <button class="accordion-button collapsed p-2 bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-comment-<%= c.id %>">
                                    <small>Voir les <%= c.replies.length %> réponses</small>
                                  </button>
                                </h2>
                                <div id="collapse-comment-<%= c.id %>" class="accordion-collapse collapse" data-bs-parent="#accordion-comment-<%= c.id %>">
                                  <div class="accordion-body p-2">
                                    <% c.replies.forEach(reply => { %>
                                      <div class="ms-4 mb-2 p-2 bg-light rounded">
                                        <div class="d-flex justify-content-between">
                                          <small class="fw-bold text-primary">
                                            <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                                            <% if (reply.is_admin_reply) { %>
                                              <span class="badge text-bg-primary" style="font-size:0.65rem;">ADMIN</span>
                                            <% } %>
                                          </small>
                                          <small class="text-muted"><%= new Date(reply.date).toLocaleDateString() %></small>
                                        </div>
                                        <p class="mb-0 mt-1 small"><%= reply.contenu %></p>
                                      </div>
                                    <% }) %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <!-- Pagination des commentaires en dehors de la boucle -->
              <%- include('partials/pagination', { pagination: commentsPagination, baseUrl: commentsBaseUrl }) %>

              <% if (typeof commentSubmitted !== 'undefined' && commentSubmitted) { %>
                <div id="comment-success-alert" class="alert alert-success">Merci ! Votre commentaire est en attente de validation.</div>
                <script>
                  setTimeout(function() {
                    var alert = document.getElementById('comment-success-alert');
                    if(alert) alert.style.display = 'none';
                  }, 3000);
                  if(window.history.replaceState) {
                    window.history.replaceState(null, null, window.location.pathname + window.location.search);
                  }
                </script>
              <% } %>

              <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <ul class="mb-0">
                    <% errors.forEach(err => { %>
                      <li><%= err %></li>
                    <% }) %>
                  </ul>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <form method="POST" action="/article/<%= article.id %>/comment">
                <% if (!user) { %>
                  <div class="mb-3">
                    <label for="nom" class="form-label">Votre nom</label>
                    <input type="text" class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('nom'))) ? 'is-invalid' : '' %>" 
                           id="nom" name="nom" value="<%= formData.nom || '' %>" required>
                    <small class="form-text text-muted">Min 3 caractères</small>
                  </div>
                <% } %>
                <div class="mb-3">
                  <label for="contenu" class="form-label">Votre commentaire</label>
                  <textarea class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('commentaire'))) ? 'is-invalid' : '' %>" 
                            id="contenu" name="contenu" rows="4" required><%= formData.contenu || '' %></textarea>
                  <small class="form-text text-muted">Min 10 caractères</small>
                </div>
                <button type="submit" class="btn-general">Publier mon commentaire</button>
                <p class="text-muted small mt-2 mb-0">Les commentaires sont modérés avant publication.</p>
              </form>
            </div>
          </section>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('like-btn');
        const countEl = document.getElementById('like-count');

        if (!btn || !countEl) return;

        const articleId = btn.dataset.articleId;

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          const label = btn.querySelector('.article-like-label');
          if (label) label.textContent = 'Merci !';

          try {
            const response = await fetch(`/article/${articleId}/like`, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'x-csrf-token': '<%= csrfToken %>'
              }
            });

            if (response.status === 400) {
              const err = await response.json().catch(() => ({ message: 'Vous avez déjà liké cet article' }));
              btn.classList.add('liked');
              if (label) label.textContent = 'Merci';
              return;
            }

            if (!response.ok) {
              const err = await response.json().catch(() => ({ message: 'Erreur serveur' }));
              throw new Error(err.message || 'Like failed');
            }

            const data = await response.json();
            const total = data.likes ?? 0;
            countEl.textContent = `${total} j'aime${total > 1 ? 's' : ''}`;
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
          } catch (error) {
            console.error('Erreur lors du like:', error);
            btn.disabled = false;
            if (label) label.textContent = "J'aime";
            alert(error.message || "Impossible d'enregistrer votre j'aime pour le moment. Merci de réessayer.");
          }
        });
      });
    </script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var commentsList = document.querySelector('.comments-list');
        if (commentsList && commentsList.children.length > 2) {
          commentsList.style.maxHeight = '220px';
          commentsList.style.overflowY = 'auto';
          commentsList.style.paddingRight = '8px';
        } else if (commentsList) {
          commentsList.style.maxHeight = '';
          commentsList.style.overflowY = '';
          commentsList.style.paddingRight = '';
        }
      });
    </script>
  </body>
</html>
