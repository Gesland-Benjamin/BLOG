<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header-article') %>
    <main class="container" style="margin-top:60px;">
      <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
          <article class="card shadow-sm border-0 mb-4">
            <% if (article.image) { %>
              <div class="ratio ratio-16x9 bg-light rounded-top" style="overflow:hidden;">
                <img 
                  src="<%= article.image %>" 
                  alt="<%= article.image_alt || article.titre %>"
                  title="<%= article.titre %>"
                  class="w-100 h-100 object-fit-cover"
                  loading="lazy"
                  srcset="<%= article.image %> 600w, <%= article.image.replace('_md', '_lg') %> 1200w"
                  sizes="(max-width: 768px) 100vw, (max-width: 1200px) 80vw, 1000px"
                  style="background-color: #f0f0f0;"
                >
              </div>
            <% } %>
            <div class="card-body p-4">
              <p class="text-muted mb-2"><%= new Date(article.date_publication).toLocaleDateString() %></p>
              <h1 class="mb-3"><%= article.titre %></h1>
              <p class="text-muted">Par <%= article.auteur %><% if (article.categorie) { %> — <%= article.categorie %><% } %></p>
              <div class="mt-4 fs-5" style="line-height:1.7;">
                <%= article.contenu %>
              </div>

              <% if (article.video) { %>
                <div class="mt-4">
                  <div class="ratio ratio-16x9 rounded overflow-hidden">
                    <% if (article.videoType === 'youtube') { %>
                      <!-- YouTube iframe -->
                      <iframe 
                        src="<%= article.video %>" 
                        frameborder="0" 
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                        referrerpolicy="strict-origin-when-cross-origin"
                        allowfullscreen>
                      </iframe>
                    <% } else if (article.videoType === 'vimeo') { %>
                      <!-- Vimeo iframe -->
                      <iframe 
                        src="<%= article.video %>" 
                        frameborder="0" 
                        allow="autoplay; fullscreen; picture-in-picture" 
                        allowfullscreen>
                      </iframe>
                    <% } else { %>
                      <!-- HTML5 video player for direct video files -->
                      <video controls class="w-100 h-100">
                        <source src="<%= article.video %>" type="video/mp4">
                        Votre navigateur ne supporte pas la lecture vidéo.
                      </video>
                    <% } %>
                  </div>
                </div>
              <% } %>

              <div class="d-flex align-items-center gap-3 mt-4">
                <button
                  id="like-btn"
                  class="btn <%= article.liked ? 'btn-success' : 'btn-outline-secondary' %>"
                  data-article-id="<%= article.id %>"
                  <%= article.liked ? 'disabled' : '' %>
                >
                  <%= article.liked ? 'Merci pour votre j\'aime' : 'Je laisse un j\'aime' %>
                </button>
                <span id="like-count" class="text-muted small">
                  <%= article.likes %> j'aime<%= article.likes > 1 ? 's' : '' %>
                </span>
              </div>

              <div class="d-flex gap-2 mt-4">
                <a href="/article/categorie/<%= encodeURIComponent(article.categorie || '') %>" class="btn btn-outline-secondary">Retour à la catégorie</a>
                <a href="/article" class="btn btn-primary">Tous les articles</a>
              </div>
            </div>
          </article>

          <section class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h4 mb-0">Commentaires</h2>
                <span class="text-muted small"><%= commentaires.length %> commentaire<%= commentaires.length > 1 ? 's' : '' %></span>
              </div>

              <% if (commentaires.length === 0) { %>
                <p class="text-muted">Soyez le premier à commenter cet article.</p>
              <% } else { %>
                <div class="list-group mb-4">
                  <% commentaires.forEach(c => { %>
                    <div class="list-group-item border-0 border-bottom pb-3">
                      <div class="d-flex justify-content-between">
                        <strong><%= c.nom || 'Lecteur' %></strong>
                        <small class="text-muted"><%= new Date(c.date).toLocaleDateString() %></small>
                      </div>
                      <p class="mb-1"><%= c.contenu %></p>
                      
                      <!-- Affichage des réponses -->
                      <% if (c.replies && c.replies.length > 0) { %>
                        <div class="mt-3 pt-2 border-top">
                          <% if (c.replies.length <= 3) { %>
                            <!-- Afficher toutes les réponses si 3 ou moins -->
                            <% c.replies.forEach(reply => { %>
                              <div class="ms-4 mb-2 p-2 bg-light rounded">
                                <div class="d-flex justify-content-between">
                                  <small class="fw-bold text-primary">
                                    <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                                    <% if (reply.is_admin_reply) { %>
                                      <span class="badge text-bg-primary" style="font-size:0.65rem;">ADMIN</span>
                                    <% } %>
                                  </small>
                                  <small class="text-muted"><%= new Date(reply.date).toLocaleDateString() %></small>
                                </div>
                                <p class="mb-0 mt-1 small"><%= reply.contenu %></p>
                              </div>
                            <% }) %>
                          <% } else { %>
                            <!-- Menu déroulant si plus de 3 réponses -->
                            <div class="accordion accordion-flush" id="accordion-comment-<%= c.id %>">
                              <div class="accordion-item border-0">
                                <h2 class="accordion-header">
                                  <button class="accordion-button collapsed p-2 bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-comment-<%= c.id %>">
                                    <small>Voir les <%= c.replies.length %> réponses</small>
                                  </button>
                                </h2>
                                <div id="collapse-comment-<%= c.id %>" class="accordion-collapse collapse" data-bs-parent="#accordion-comment-<%= c.id %>">
                                  <div class="accordion-body p-2">
                                    <% c.replies.forEach(reply => { %>
                                      <div class="ms-4 mb-2 p-2 bg-light rounded">
                                        <div class="d-flex justify-content-between">
                                          <small class="fw-bold text-primary">
                                            <%= reply.nom || (reply.user ? reply.user.nom_prenom : 'Admin') %>
                                            <% if (reply.is_admin_reply) { %>
                                              <span class="badge text-bg-primary" style="font-size:0.65rem;">ADMIN</span>
                                            <% } %>
                                          </small>
                                          <small class="text-muted"><%= new Date(reply.date).toLocaleDateString() %></small>
                                        </div>
                                        <p class="mb-0 mt-1 small"><%= reply.contenu %></p>
                                      </div>
                                    <% }) %>
                                  </div>
                                </div>
                              </div>
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    </div>
                  <% }) %>
                </div>
              <% } %>

              <% if (typeof commentSubmitted !== 'undefined' && commentSubmitted) { %>
                <div class="alert alert-success">Merci ! Votre commentaire est en attente de validation.</div>
              <% } %>

              <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <ul class="mb-0">
                    <% errors.forEach(err => { %>
                      <li><%= err %></li>
                    <% }) %>
                  </ul>
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              <% } %>

              <form method="POST" action="/article/<%= article.id %>/comment">
                <% if (!user) { %>
                  <div class="mb-3">
                    <label for="nom" class="form-label">Votre nom</label>
                    <input type="text" class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('nom'))) ? 'is-invalid' : '' %>" 
                           id="nom" name="nom" value="<%= formData.nom || '' %>" required>
                    <small class="form-text text-muted">Min 3 caractères</small>
                  </div>
                <% } %>
                <div class="mb-3">
                  <label for="contenu" class="form-label">Votre commentaire</label>
                  <textarea class="form-control <%= (errors && errors.length > 0 && errors.some(e => e.includes('commentaire'))) ? 'is-invalid' : '' %>" 
                            id="contenu" name="contenu" rows="4" required><%= formData.contenu || '' %></textarea>
                  <small class="form-text text-muted">Min 10 caractères</small>
                </div>
                <button type="submit" class="btn btn-bd-primary">Publier mon commentaire</button>
                <p class="text-muted small mt-2 mb-0">Les commentaires sont modérés avant publication.</p>
              </form>
            </div>
          </section>
        </div>
      </div>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('like-btn');
        const countEl = document.getElementById('like-count');

        if (!btn || !countEl) return;

        const articleId = btn.dataset.articleId;

        btn.addEventListener('click', async () => {
          btn.disabled = true;
          btn.textContent = 'Merci !';

          try {
            const response = await fetch(`/article/${articleId}/like`, {
              method: 'POST',
              headers: { 
                'Content-Type': 'application/json',
                'x-csrf-token': '<%= csrfToken %>'
              }
            });

            if (!response.ok) {
              throw new Error('Like failed');
            }

            const data = await response.json();
            const total = data.likes ?? 0;
            countEl.textContent = `${total} j'aime${total > 1 ? 's' : ''}`;
            btn.classList.remove('btn-outline-secondary');
            btn.classList.add('btn-success');
          } catch (error) {
            console.error('Erreur lors du like:', error);
            btn.disabled = false;
            btn.textContent = "Je laisse un j'aime";
            alert("Impossible d'enregistrer votre j'aime pour le moment. Merci de réessayer.");
          }
        });
      });
    </script>
  </body>
</html>
