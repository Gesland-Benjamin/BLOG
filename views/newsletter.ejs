<%- include('partials/head') %>
<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <body>
    <%- include('partials/header-article') %>
    <main class="container" style="max-width:400px; margin-top:60px;">
      <div class="card shadow-sm">
        <div class="card-body">
          <h2 class="mb-4 text-center">Inscription à la newsletter</h2>
          <form method="POST" action="/newsletter/subscribe">
            <div class="mb-3">
              <label for="email" class="form-label">Adresse email</label>
              <input type="email" class="form-control" id="email" name="email" required autocomplete="email">
            </div>
            <button type="submit" class="btn btn-bd-primary w-100">S'abonner</button>
          </form>
        </div>
      </div>
      <br>
    </main>
    
    <script src="../assets/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>