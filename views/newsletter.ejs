<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="newsletter-page">
      <section class="newsletter-form-card" aria-labelledby="newsletter-title">
        <span class="newsletter-eyebrow">Les nouvelles d’Emi’Pulse</span>
        <h1 id="newsletter-title" class="newsletter-form-title">Un peu d’Emi dans votre boîte mail</h1>
        <p class="newsletter-message">Les nouveaux articles, les idées et les actualités du blog, directement chez vous.</p>
        <% if (typeof message !== 'undefined' && message) { %>
          <div class="newsletter-notice" role="status"><strong>Vérifiez votre boîte mail</strong><p><%= message %></p></div>
          <a href="/article" class="newsletter-submit newsletter-action">Découvrir les articles</a>
          <p class="newsletter-fineprint"><a href="/newsletter">Corriger mon adresse ou renvoyer une confirmation</a></p>
        <% } else { %>
          <% if (errors && errors.length) { %>
            <div class="newsletter-notice newsletter-notice-error" id="newsletter-errors" role="alert"><ul><% errors.forEach(error => { %><li><%= error %></li><% }) %></ul></div>
          <% } %>
          <form method="POST" action="/newsletter/subscribe" class="newsletter-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="newsletter-form-group">
              <label for="newsletter-email">Votre adresse e-mail</label>
              <input type="email" id="newsletter-email" name="email" value="<%= formData.email || '' %>" required autocomplete="email" inputmode="email" maxlength="150" placeholder="vous@exemple.fr" aria-describedby="newsletter-help<%= errors.length ? ' newsletter-errors' : '' %>">
            </div>
            <button type="submit" class="newsletter-submit">Recevoir la newsletter <span aria-hidden="true">→</span></button>
          </form>
          <p id="newsletter-help" class="newsletter-fineprint">Un e-mail vous permettra de confirmer votre inscription. Vous pourrez vous désabonner à tout moment.</p>
        <% } %>
        <div class="newsletter-card-footer"><span>Une inscription en deux étapes</span><span>Vous gardez le choix</span></div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
