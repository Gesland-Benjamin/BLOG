<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body>
    <%- include('partials/header', { withContainer: true }) %>
    <main class="auth-wrapper">
      <div class="auth-container">
        <div class="newsletter-form-card">
          <h2 class="newsletter-form-title">📧 Newsletter Emi'Pulse</h2>
          
          <% if (typeof message !== 'undefined' && message) { %>
            <div class="auth-alert info" role="alert">
              <%= message %>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
          
          <% if (errors && errors.length > 0) { %>
            <div class="auth-alert error" role="alert">
              <ul>
                <% errors.forEach(err => { %>
                  <li><%= err %></li>
                <% }) %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
          <% } %>
          
          <p class="newsletter-message">Recevez nos meilleurs articles sur toutes nos thématiques directement dans votre boîte mail.</p>
          
          <form method="POST" action="/newsletter/subscribe" class="newsletter-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="newsletter-form-group">
              <label for="email">Adresse email</label>
              <input type="email" class="<%= (errors && errors.length > 0 && errors.some(e => e.includes('email'))) ? 'invalid' : '' %>" 
                     id="email" name="email" value="<%= formData.email || '' %>" required autocomplete="email"
                     placeholder="votre@email.com">
            </div>
            <button type="submit" class="newsletter-submit">S'abonner à la newsletter</button>
          </form>
          
          <p class="auth-footer">
            En vous inscrivant, vous recevrez un email de confirmation.<br>
            Vous pourrez vous désinscrire à tout moment.
          </p>
        </div>
      </div>
      <br>
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>