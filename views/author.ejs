<!doctype html>
<html lang="fr">
<%- include('partials/head') %>
<body>
<%- include('partials/header', { withContainer: true }) %>
<main class="content-wrapper"><div class="article-detail-container"><section class="article-detail-card"><div class="article-detail-content">
  <h1><%= author?.name || 'Émilie' %></h1>
  <p>Émilie est l’auteure principale d’Emi’Pulse.</p>
  <p>Présentation à compléter par Émilie : son parcours, ses sujets de prédilection et les liens qu’elle souhaite partager.</p>
  <p><a href="/a-propos">À propos d’Emi’Pulse</a> · <a href="/renseignements">Contacter Emi</a></p>
  <h2>Ses articles</h2>
  <% if (!articles.length) { %><p>Aucun article à afficher pour le moment.</p><% } %>
  <ul><% articles.forEach(article => { %><li><a href="<%= articlePath(article) %>"><%= article.title %></a></li><% }) %></ul>
  <%- include('partials/pagination', { pagination, baseUrl }) %>
</div></section></div></main>
<%- include('partials/footer') %><%- include('partials/scripts') %>
</body></html>
