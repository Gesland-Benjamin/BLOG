<!doctype html>
<html lang="fr" data-bs-theme="auto">
  <%- include('partials/head') %>
  <body class="bo">
    <%- include('partials/header', { withContainer: true, includeNavbar: true }) %>
    <svg xmlns="http://www.w3.org/2000/svg" class="d-none">
      <symbol
        id="aperture"
        fill="none"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        viewBox="0 0 24 24"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path
          d="M14.31 8l5.74 9.94M9.69 8h11.48M7.38 12l5.74-9.94M9.69 16L3.95 6.06M14.31 16H2.83m13.79-4l-5.74 9.94"
        ></path>
      </symbol>
      <symbol id="cart" viewBox="0 0 16 16">
        <path
          d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"
        ></path>
      </symbol>
      <symbol id="chevron-right" viewBox="0 0 16 16">
        <path
          fill-rule="evenodd"
          d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"
        ></path>
      </symbol>
    </svg>
    <main class="home-wrapper">
      <!-- Carrousel mélangé Événements + Nouveautés -->
      <div class="carousel-wrapper">
        <%- include('partials/carousel', { carouselItems }) %>
      </div>
      
      <!-- Cartes Recent Posts et Archives -->
      <div class="sections-wrapper">
        <div class="home-content-grid">
          <div class="home-main-content">
            <section class="home-featured-articles left-sections smeg-frame">
              <% (topLikedSections || []).forEach((s, idx) => { const isReverse = idx % 2 === 1; %>
                <div class="home-featured-card card-bordered smeg-frame">
                  <div class="home-featured-layout">
                    <div class="article-card-text">
                      <h1 class="article-card-title"><%= s.titre %></h1>
                      <p class="article-card-excerpt"><%= s.extrait %>...</p>
                      <p class="article-card-author">Par <%= s.auteur %> • <%= s.categorie %></p>
                      <p class="article-card-link">
                        <a href="/article/<%= s.id %>">Lire plus...</a>
                      </p>
                    </div>
                    <div class="article-card-image-wrapper">
                      <% if (s.image) { %>
                        <img src="<%= s.image %>" alt="<%= s.titre %>" class="card-bordered" />
                      <% } else { %>
                        <div class="carousel-placeholder">
                          Aucune image
                        </div>
                      <% } %>
                    </div>
                  </div>
                </div>
              <% }) %>
            </section>
          </div>
          <aside class="home-sidebar">
            <div class="card-smeg-stack">
              <article class="card-smeg smeg-frame">
                <div class="sidebar-section">
                  <h4 class="sidebar-title">Derniers articles</h4>
                  <ul class="list-group">
                    <% if (recentPosts && recentPosts.length) { %>
                      <% recentPosts.forEach((p, idx) => { %>
                        <li class="list-group-item">
                          <a href="/article/<%= p.id %>" class="sidebar-article-link">
                            <div class="sidebar-article-img-wrapper">
                              <% if (p.image) { %>
                                <img src="<%= p.image %>" alt="<%= p.titre %>">
                              <% } else { %>
                                <svg aria-hidden="true" width="56" height="56" class="sidebar-article-img-placeholder" xmlns="http://www.w3.org/2000/svg">
                                  <rect width="100%" height="100%" fill="#e9ecef"></rect>
                                  <text x="50%" y="50%" fill="#adb5bd" dy=".3em" font-size="12" text-anchor="middle">Article</text>
                                </svg>
                              <% } %>
                            </div>
                            <div class="sidebar-article-info">
                              <span class="sidebar-article-title"><%= p.titre %></span>
                              <span class="sidebar-article-meta">Par <%= p.auteur %></span>
                            </div>
                          </a>
                        </li>
                      <% }); %>
                    <% } else { %>
                      <li class="sidebar-list-empty">Aucun article récent.</li>
                    <% } %>
                  </ul>
                </div>
              </article>

              <article class="card-smeg smeg-frame">
                <div class="sidebar-section">
                  <h4 class="sidebar-title">Archives</h4>
                  <ol class="sidebar-list">
                    <li><a href="/archive/2025/12">Décembre 2025</a></li>
                    <li><a href="/archive/2025/11">Novembre 2025</a></li>
                    <li><a href="/archive/2025/10">Octobre 2025</a></li>
                    <li><a href="/archive/2025/9">Septembre 2025</a></li>
                    <li><a href="/archive/2025/8">Août 2025</a></li>
                    <li><a href="/archive/2025/7">Juillet 2025</a></li>
                    <li><a href="/archive/2025/6">Juin 2025</a></li>
                    <li><a href="/archive/2025/5">Mai 2025</a></li>
                    <li><a href="/archive/2025/4">Avril 2025</a></li>
                    <li><a href="/archive/2025/3">Mars 2025</a></li>
                    <li><a href="/archive/2025/2">Février 2025</a></li>
                    <li><a href="/archive/2025/1">Janvier 2025</a></li>
                  </ol>
                </div>
              </article>
            </div>
          </aside>
        </div>
      </div>
      
    </main>
    <%- include('partials/footer') %>
    <%- include('partials/scripts') %>
  </body>
</html>
