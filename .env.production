# ===== CONFIGURATION PRODUCTION =====
# À personnaliser selon votre serveur

# ===== Serveur =====
NODE_ENV=production
PORT=3000
APP_URL=https://yourdomain.com

# ===== Base de données =====
DB_NAME=blog_prod
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_HOST=db.example.com
DB_PORT=5432
DB_DIALECT=postgres

# ===== Sessions =====
SESSION_SECRET=your_very_long_random_secret_key_minimum_32_characters_here_2024

# ===== HTTPS & SSL =====
HTTPS_ENABLED=true
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
REDIRECT_HTTP=true

# ===== CORS =====
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ===== Email =====
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=noreply@yourdomain.com

# ===== Répertoires =====
TEMP_DIR=/var/tmp/blog-uploads
STATIC_DIR=/var/www/blog/uploads

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===== Optionnel: PM2 Plus Monitoring =====
PM2_PUBLIC_KEY=your_pm2_public_key
PM2_SECRET_KEY=your_pm2_secret_key
PM2_INSTANCE_ID=blog-prod
