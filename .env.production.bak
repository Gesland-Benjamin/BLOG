# ===== CONFIGURATION PRODUCTION =====
# À personnaliser selon votre serveur

# ===== Serveur =====
NODE_ENV=production
PORT=3000
APP_URL=https://emi-pulse.fr

# ===== Base de données principale =====
DB_NAME=u985847002_blog
DB_USER=u985847002_contact
DB_PASSWORD=Putaindemotdepasse145
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DIALECT=mysql

# ===== Base de données sessions =====
SESSION_DB_NAME=u985847002_sessions
SESSION_DB_USER=u985847002_sessions
SESSION_DB_PASSWORD=Sessions145
SESSION_DB_HOST=127.0.0.1
SESSION_DB_PORT=3306

# ===== Sessions =====
SESSION_SECRET=your_very_long_random_secret_key_minimum_32_characters_here_2024

# ===== HTTPS & SSL =====
HTTPS_ENABLED=true
SSL_KEY_PATH=/etc/ssl/private/yourdomain.key
SSL_CERT_PATH=/etc/ssl/certs/yourdomain.crt
REDIRECT_HTTP=true

# ===== CORS =====
CORS_ORIGINS=https://emi-pulse.fr,https://www.emi-pulse.fr

# ===== Email =====
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USER=contact@emi-pulse.fr
EMAIL_PASSWORD=Alexandre145@
EMAIL_FROM=contact@emi-pulse.fr

# ===== Répertoires =====
TEMP_DIR=/var/tmp/blog-uploads
STATIC_DIR=/var/www/blog/uploads

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===== Optionnel: PM2 Plus Monitoring =====
PM2_PUBLIC_KEY=your_pm2_public_key
PM2_SECRET_KEY=your_pm2_secret_key
PM2_INSTANCE_ID=blog-prod